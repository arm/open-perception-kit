# syntax=docker/dockerfile:1

FROM pek-dev

ARG PEK_HAILO_ARCH

USER root

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
  set -eux; \
  test "$(dpkg --print-architecture)" = arm64; \
  test -f /etc/apt/sources.list.d/raspberrypi.list; \
  apt-get update; \
  case "${PEK_HAILO_ARCH}" in \
    h8) \
      apt-get install -y --no-install-recommends \
      hailo-models hailo-tappas-core hailort \
      python3-hailo-tappas python3-hailort rpicam-apps-hailo-postprocess \
      ;; \
    h10) \
      apt-get install -y --no-install-recommends \
      h10-hailort hailo-models hailo-tappas-core python3-h10-hailort \
      python3-hailo-tappas rpicam-apps-hailo-postprocess \
      ;; \
    *) \
      echo "Unsupported Hailo architecture: ${PEK_HAILO_ARCH}" >&2; \
      exit 1 \
      ;; \
  esac

ENV PEK_HAILORT=enabled

USER dev
WORKDIR /work
