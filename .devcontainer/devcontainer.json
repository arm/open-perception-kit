{
  "name": "amp-dev-forge",
  "dockerComposeFile": [
      "${localWorkspaceFolder}/.devcontainer/docker-compose.devcont.yaml",
      "${localWorkspaceFolder}/.devcontainer/docker-compose.devcont.video.yaml"
  ], 
  "service": "amp-dev-base",

  "remoteUser": "devgoblin",
  "workspaceFolder": "/work",

  "initializeCommand": "${localWorkspaceFolder}/scripts/gen_cam.sh",

  "containerEnv": {
  	"CONTAINER_TYPE": "default",
    "HOST_OS": "${localEnv:OSTYPE}",
    "HOST_DISPLAY": "${localEnv:DISPLAY}"
  },

  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {}
  },

  "overrideCommand": true,
  "init": true,

  "postCreateCommand": "bash .devcontainer/setup.sh",

  "customizations": {
    "vscode": {
      "recommendations": ["ms-python.python", "ms-vscode.cpptools"],
      "extensions": [
        "xaver.clang-format",
        "ms-vscode.cpptools-extension-pack"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "python.defaultInterpreterPath": "/work/.venv/bin/python"
      }
    }
  }
}
