# Ignore Git metadata
.git
.gitignore
.cache/

# Host-local configuration can contain credentials and generated device state.
# Compose reads these files before the build; they must never enter its context.
.env
devices.env
.devcontainer/.env
.devcontainer/devices.env
.devcontainer/cameras.env
.devcontainer/*.video.yaml
.devcontainer/*.audio.yaml
.devcontainer/*.npu.yaml
.devcontainer/*.shared_memory.yaml

# Build outputs
cmake-build*/
**/build/
development/build/
var/*
!var/.gitignore
!var/libexecutorch-dev-*.deb
deps/
*.tgz

# IDE / editor
.vscode/
.idea/
.DS_Store

# Python / virtualenvs
.venv/
**/__pycache__/

# Logs and temp
*.log
*.tmp

# Topo / graphs / large generated artifacts
graphs/
