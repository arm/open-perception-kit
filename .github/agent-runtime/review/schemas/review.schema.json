{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "overall_recommendation",
    "overall_score",
    "overall_confidence",
    "findings"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "overall_recommendation": {
      "type": "string",
      "enum": [
        "approve",
        "comment",
        "request_changes"
      ]
    },
    "overall_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "overall_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "severity",
          "score",
          "confidence",
          "path",
          "diff_side",
          "start_line",
          "end_line",
          "body",
          "suggestion"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "note",
              "major",
              "critical"
            ]
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "diff_side": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "LEFT",
              "RIGHT",
              null
            ]
          },
          "start_line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "end_line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "suggestion": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
