{
  "display_name": "Workflow Action Update Agent",
  "automation_name": "workflow-action-update-agent",
  "repair_branch_template": "feature/{ticket_id}/bot-workflow-action-update-agent-run-{source_run_id}",
  "repair_branch_guard_regex": "^feature/[^/]+/bot-workflow-action-update-agent-run-",
  "pr_trigger_label": "run-pek-ci",
  "pr_title_template": "[bot] Repair workflow failures from run {source_run_id}",
  "commit_subject_template": "[bot] Repair workflow failures from run {source_run_id}",
  "commit_notes_template": "Source workflow: {source_workflow_name}\n\nSource run: {source_run_url}\n",
  "pr_description_template": "Source workflow run: {source_run_url}\n\nThis draft PR was generated by `{automation_name}` from the failing reports and logs of `{source_workflow_name}`.\n\nMinimal repair for source run {source_run_id}. The workflow adds the `{pr_trigger_label}` label after opening this draft PR so the existing PR workflows rerun before merge.",
  "codex_model": "gpt-5.5",
  "codex_effort": "",
  "prompt_context_files": [
    ".github/ci/workflow-release-review.md",
    ".github/PULL_REQUEST_TEMPLATE.md",
    ".github/workflows/codex-review.yml",
    ".github/workflows/pek-ci.yml",
    ".github/workflows/sonar.yml",
    ".github/compose.ci.yaml"
  ],
  "validation_commands": [
    "python3 -m unittest discover -s tools/expkits-ci/tests -p 'test_detect_secrets_quality_flow.py'",
    "python3 -m unittest discover -s tools/expkits-ci/tests -p 'test_workflow_action_update_agent_flow.py'",
    "git diff --stat"
  ],
  "validation_workflows": [
    {
      "workflow_file": "codex-review.yml",
      "workflow_name": "Codex Review",
      "review_state_script": "codex-review/scripts/fetch-review-state.py",
      "allowed_review_recommendations": [
        "approve",
        "comment"
      ]
    },
    {
      "workflow_file": "pek-ci.yml",
      "workflow_name": "Perception Experience Kit CI Pipeline"
    },
    {
      "workflow_file": "sonar.yml",
      "workflow_name": "Sonar"
    }
  ]
}
