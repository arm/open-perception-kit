{
  "display_name": "Workflow Dependency Freshness Repair",
  "automation_name": "workflow-dependency-freshness-repair",
  "require_failure_conclusion": false,
  "repair_branch_template": "feature/{ticket_id}/bot-workflow-dependency-freshness-{source_run_id}",
  "repair_branch_guard_regex": "^feature/[^/]+/bot-workflow-dependency-freshness-",
  "pr_trigger_label": "run-pek-ci",
  "pr_title_template": "[bot] Repair workflow dependency freshness from run {source_run_id}",
  "commit_subject_template": "[bot] Repair workflow dependency freshness from run {source_run_id}",
  "commit_notes_template": "Source workflow: {source_workflow_name}\n\nSource run: {source_run_url}\n\nSeed report artifact: workflow-dependency-freshness\n",
  "pr_description_template": "Source workflow run: {source_run_url}\n\nThis draft PR was generated by `{automation_name}` from the nightly workflow dependency freshness report and its source run artifacts.\n\nThe repair keeps the original report artifact as the starting evidence, updates the outdated workflow refs, then reruns the configured PR validation workflows before merge.",
  "codex_model": "gpt-5.3-codex",
  "codex_effort": "",
  "prompt_context_files": [
    ".github/workflows/workflow-audit.yml",
    "scripts/private/workflow_audit_report.py",
    ".github/PULL_REQUEST_TEMPLATE.md",
    ".github/workflows/codex-review.yml",
    ".github/workflows/pek-ci.yml",
    ".github/workflows/sonar.yml",
    ".github/compose.ci.yaml"
  ],
  "validation_commands": [
    "python3 -m unittest discover -s tools/expkits-ci/tests -p 'test_detect_secrets_quality_flow.py'",
    "python3 -m unittest discover -s tools/expkits-ci/tests -p 'test_workflow_action_update_agent_flow.py'",
    "git diff --stat"
  ],
  "validation_workflows": [
    {
      "workflow_file": "codex-review.yml",
      "workflow_name": "Codex Review",
      "review_state_script": "codex-review/scripts/fetch-review-state.py",
      "allowed_review_recommendations": [
        "approve",
        "comment"
      ]
    },
    {
      "workflow_file": "workflow-audit.yml",
      "workflow_name": "Workflow Dependency Freshness"
    },
    {
      "workflow_file": "pek-ci.yml",
      "workflow_name": "Perception Experience Kit CI Pipeline"
    },
    {
      "workflow_file": "sonar.yml",
      "workflow_name": "Sonar"
    }
  ]
}
