{
  "reviewProfile": {
    "model": "gpt-5.3-codex",
    "reasoningEffort": "high",
    "conceptualSensitivity": "high"
  },
  "categories": [
    {
      "id": "note",
      "label": "Note",
      "severity": "note"
    },
    {
      "id": "impl_easy",
      "label": "Implementation issue",
      "severity": "major"
    },
    {
      "id": "conceptual",
      "label": "Conceptual issue",
      "severity": "major"
    }
  ],
  "inlineSuggestions": {
    "enabled": true,
    "maxChangedLines": 8,
    "maxFilesTouched": 2,
    "minConfidence": 0.75
  },
  "conceptualReview": {
    "enabled": true,
    "minRiskScore": 0.3,
    "includeRefactorIdeas": true
  },
  "decisionPolicy": {
    "approveWhenNoFindings": false,
    "requestChangesAtSeverity": "major"
  },
  "scope": {
    "includeGlobs": [
      "**/*"
    ],
    "excludeGlobs": [
      "development/build/**",
      "subprojects/**",
      ".git/**"
    ]
  },
  "diffSource": {
    "mode": "base_branch",
    "baseBranch": "origin/main"
  }
}
