{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "onnx",
            "type": "cppdbg",
            "request": "launch",
            "program": "/usr/bin/gst-launch-1.0",
            "args": [
                "filesrc", "location=/work/etc/images/katana.jpg", "!",
                "jpegdec", "!",
                "videoconvert", "!", "video/x-raw,format=BGRA", "!",
                "ampinfer", "opchain-path=/work/etc/models/ultraface/opchain.json", "active=true", "!",
                "ampinfer", "opchain-path=/work/etc/models/gazedetection/for-all-faces-opchain.json", "active=true", "!",
                "ampinfer", "opchain-path=/work/etc/models/yolo/opchain.json", "active=true", "!",
                "ampinfer", "opchain-path=/work/etc/models/paddleocr/opchain.json", "active=true", "!",
                "amposd", "enabled=true", "!",
                "videoconvert", "!", "pngenc", "!", "filesink", "location=/work/var/result.png"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                { "name": "GST_PLUGIN_PATH", "value": "${workspaceFolder}/development/build/meson-out" }
            ],
            "externalConsole": false,
            "MIMode":"gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set disassembly flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
