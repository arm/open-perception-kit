{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "AMP Debug latest",
            "preLaunchTask": "00 Build Project",
            "type": "cppdbg",
            "request": "launch",
            "program": "/work/tools/amp-menu",
            "args": [
                "-l"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "GST_PLUGIN_PATH",
                    "value": "${workspaceFolder}/development/build/meson-out"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set disassembly flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "AMP Debug selection",
            "preLaunchTask": "00 Build Project",
            "type": "cppdbg",
            "request": "launch",
            "program": "/work/tools/amp-menu",
            "args": [
                "-l",
                //"-f",
                //"30",
                //"/work/scripts/pipelines/testing/only-ampsink.json",
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "GST_PLUGIN_PATH",
                    "value": "${workspaceFolder}/development/build/meson-out"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set disassembly flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Attach to PyBind",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "justMyCode": false
        },
    ],
    "inputs": [
        {
            "id": "selectedPipeline",
            "type": "pickString",
            "description": "Selected pipeline to debug.",
            "default": "01-full-onnx",
            "options": [
                "01-full-onnx",
                "02-full-onnx-hailo8"
            ]
        }
    ]
}