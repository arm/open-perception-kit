{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "00 Build Project",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/build-elements.sh",
            "args": [
                "debug"
            ],
            "dependsOn": "99 Make build dir",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}/development/build"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": [
                {
                    "base": "$gcc",
                    "fileLocation": [
                        "relative",
                        "${workspaceFolder}/development/build"
                    ]
                }
            ]
        },
        {
            "label": "00 Run project with default pipeline",
            "type": "shell",
            "command": "/work/scripts/amp-menu",
            "hide": true,
            "args": [
                ""
            ],
            "problemMatcher": []
        },
        {
            "label": "00 Run project with latest pipeline",
            "type": "shell",
            "command": "/work/scripts/amp-menu",
            "hide": true,
            "args": [
                "-l"
            ],
            "problemMatcher": []
        },
        {
            "label": "00 Run project and select pipeline",
            "type": "shell",
            "command": "/work/scripts/amp-menu",
            "hide": true,
            "args": [
                "02-full-onnx-hailo8",
                "03-full-onnx-hailo8l",
                "04-full-onnx-hailo10",
                "cam-connect",
                "gaze-detection",
                "tracker-pc",
                "tracker-rpi-hailo8"
            ],
            "problemMatcher": []
        },
        {
            "label": "01 Clean Project",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/build-elements.sh",
            "args": [
                "clean"
            ],
            "dependsOn": "99 Make build dir",
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}/development/build"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "02 Build Tests",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/build-elements.sh",
            "args": [
                "debug",
                "true"
            ],
            "dependsOn": "99 Make build dir",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}/development/build"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": [
                {
                    "base": "$gcc",
                    "fileLocation": [
                        "relative",
                        "${workspaceFolder}/development/build"
                    ]
                }
            ]
        },
        {
            "label": "03 Run Tests",
            "type": "shell",
            "command": "meson",
            "args": [
                "test",
                "-C",
                "${workspaceFolder}/development/build",
                "--print-errorlogs"
            ],
            "dependsOn": "99 Make build dir",
            "group": "test",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "99 Make build dir",
            "type": "shell",
            "command": "mkdir",
            "args": [
                "-p",
                "${workspaceFolder}/development/build"
            ]
        },
    ],
    "inputs": [
        {
            "id": "buildType",
            "description": "Build Type:",
            "type": "pickString",
            "options": [
                "debug",
                "release"
            ]
        }
    ]
}