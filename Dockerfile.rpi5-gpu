ARG OPK_DEV_IMAGE=open-perception-kit-dev
FROM ${OPK_DEV_IMAGE} AS rpi5-runtime-build
USER root
WORKDIR /opt/opk-rpi5-build

# Build dependencies stay in this stage; the host driver is never modified.
# hadolint ignore=DL3008
RUN test "$(uname -m)" = aarch64 && \
    apt-get update && apt-get install -y --no-install-recommends \
    bison flex patch python3-mako python3-yaml glslang-tools libdrm-dev \
    zlib1g-dev libzstd-dev && rm -rf /var/lib/apt/lists/*

COPY requirements/mlwl.json requirements/vulkan-emulation.json requirements/rpi5-mesa.json requirements/
COPY tools/perception/artifacts.py tools/perception/release_common.py tools/perception/sdk_config.py tools/perception/
COPY scripts/private/install-vulkan-emulation.py scripts/private/
COPY scripts/private/rpi5-gpu/ scripts/private/rpi5-gpu/

RUN python3 scripts/private/rpi5-gpu/install-mesa.py /opt/opk-rpi5/mesa
RUN python3 scripts/private/install-vulkan-emulation.py --rpi5 /opt/opk-rpi5/emulation

FROM ${OPK_DEV_IMAGE}
COPY --from=rpi5-runtime-build /opt/opk-rpi5/ /opt/opk-rpi5/
ENV VK_DRIVER_FILES=/opt/opk-rpi5/mesa/share/vulkan/icd.d/broadcom_icd.aarch64.json \
    VK_LAYER_PATH=/opt/opk-rpi5/emulation/share/vulkan/explicit_layer.d \
    VK_ADD_LAYER_PATH="" \
    VK_INSTANCE_LAYERS=VK_LAYER_ML_Graph_Emulation:VK_LAYER_ML_Tensor_Emulation \
    LD_LIBRARY_PATH=/opt/opk-rpi5/mesa/lib:/opt/opk-rpi5/emulation/lib64:${LD_LIBRARY_PATH}
