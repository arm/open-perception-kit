{
    "name": "ArcFaceMobileFaceNet HAILO",
    "displayName": "ArcFace MobileFaceNet",
    "task": "Face embedding",
    "runtime": "Hailo 10",
    "description": "Hailo 10-compiled ArcFace MobileFaceNet face embedding model.",
    "ops": [
        {
            "id": "pek-std-ops/InferenceController",
            "attributes": {
                "contentType": "humanFace"
            }
        },
        {
            "id": "pek-std-ops/GenericImagePreprocess",
            "attributes": {
                "inputImageTensorIndex": 0,
                "inputImageSourceName": "pipelineVideoFrame"
            }
        },
        {
            "id": "pek-hailort-ops/Inference",
            "attributes": {
                "modelDescriptor": "/work/config/models/arcface_mobilefacenet_hailo10/model.json"
            }
        },
        {
            "id": "pek-std-ops/GenericPostprocess",
            "attributes": {
                "parser": "ObjectEmbeddingParser"
            }
        }
    ]
}
