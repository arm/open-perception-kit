{
  "version": "2.0.0",
  "name": "MobileGazeMobilenetV2Int8Executorch",
  "displayName": "MobileGaze MobileNetV2 INT8 (ExecuTorch)",
  "task": "Gaze estimation",
  "runtime": "ExecuTorch (XNNPACK)",
  "description": "Estimates gaze direction from human-face crops.",
  "ops": [
    {"id": "opk-std-ops/InferenceController", "instanceId": "opk-std-ops-InferenceController-0", "loopId": 1, "attributes": {"sourceProducer": ""}},
    {"id": "opk-std-ops/GenericImagePreprocess", "loopId": 1, "attributes": {"inputImageTensorIndex": 0, "inputImageSourceName": "pipelineVideoFrame"}},
    {"id": "opk-executorch-ops/Inference", "loopId": 1, "attributes": {"modelDescriptor": "model.json"}},
    {"id": "opk-std-ops/GenericPostprocess", "instanceId": "opk-std-ops-GenericPostprocess-0", "loopId": 1, "attributes": {"parser": "GazeDetectionParser", "angleBinWidthDeg": 4}}
  ]
}
