{
	"name": "ImageNet Hailo",
	"description": "Hailo 8L-compiled whole-frame ImageNet classifier that reports top category matches with confidence scores.",
	"ops": [
		{
			"id": "pek-std-ops/InferenceController",
			"attributes": {}
		},
		{
			"id": "pek-std-ops/GenericImagePreprocess",
			"attributes": {
				"inputImageTensorIndex": 0,
				"inputImageSourceName": "pipelineVideoFrame"
			}
		},
		{
			"id": "pek-hailort-ops/Inference",
			"attributes": {
				"modelDescriptor": "/work/config/models/mobilenetv2-hailo8l/model.json"
			}
		},
		{
			"id": "pek-std-ops/GenericPostprocess",
			"attributes": {
				"parser": "ImageNetClassificationParser",
				"topK": 5,
				"confidenceThreshold": 0.001
			}
		}
	]
}
