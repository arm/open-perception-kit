{
	"version": "1.0.1",
	"name": "ImageNet Python",
	"displayName": "MobileNetV2 with Python",
	"task": "Image classification",
	"runtime": "ONNX + Python",
	"description": "MobileNetV2 classification with comparable stateful Python and C++ postprocessing.",
	"ops": [
		{
			"id": "opk-std-ops/InferenceController",
			"attributes": {}
		},
		{
			"id": "opk-std-ops/GenericImagePreprocess",
			"attributes": {
				"inputImageTensorIndex": 0,
				"inputImageSourceName": "pipelineVideoFrame"
			}
		},
		{
			"id": "opk-onnx-ops/Inference",
			"attributes": {
				"modelDescriptor": "/work/config/models/mobilenetv2/model.json"
			}
		},
		{
			"id": "opk-python-ops/PythonScript",
			"instanceId": "python-classifier",
			"attributes": {
				"script": "scripts/python_classification.py"
			}
		},
		{
			"id": "opk-std-ops/GenericPostprocess",
			"instanceId": "cpp-classifier",
			"attributes": {
				"parser": "ImageNetClassificationParser",
				"topK": 5,
				"confidenceThreshold": 0.0
			}
		}
	]
}
