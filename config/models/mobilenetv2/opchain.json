{
	"name": "ImageNet",
	"description": "Classifies the whole video frame against ImageNet categories and reports the top matches with confidence scores. Runs independently and does not require another model.",
	"ops": [
		{
			"id": "pek-std-ops/InferenceController",
			"attributes": {}
		},
		{
			"id": "pek-std-ops/GenericImagePreprocess",
			"attributes": {
				"inputImageTensorIndex": 0,
				"inputImageSourceName": "pipelineVideoFrame"
			}
		},
		{
			"id": "pek-onnx-ops/Inference",
			"attributes": {
				"modelDescriptor": "/work/config/models/mobilenetv2/model.json"
			}
		},
		{
			"id": "pek-std-ops/GenericPostprocess",
			"attributes": {
				"parser": "ImageNetClassificationParser",
				"topK": 5,
				"confidenceThreshold": 0.001
			}
		}
	]
}
