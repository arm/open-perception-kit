{
  "version": "1.0.1",
  "name": "Modnet",
  "displayName": "MODNet",
  "task": "Foreground segmentation",
  "runtime": "ONNX",
  "description": "Modnet real time background matting model.",
  "ops": [
    {
      "id": "opk-std-ops/InferenceController",
      "attributes": {}
    },
    {
      "id": "opk-std-ops/GenericImagePreprocess",
      "attributes": {
        "inputImageTensorIndex": 0,
        "inputImageSourceName": "pipelineVideoFrame"
      }
    },
    {
      "id": "opk-onnx-ops/Inference",
      "attributes": {
        "modelDescriptor": "model.json"
      }
    },
    {
      "id": "opk-std-ops/GenericPostprocess",
      "attributes": {
        "parser": "ModNetSegmentationParser",
        "thresholdLow": 0.2,
        "thresholdHigh": 0.8
      }
    }
  ]
}
