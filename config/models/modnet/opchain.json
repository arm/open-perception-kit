{
  "name": "Modnet",
  "description": "Modnet real time background matting model.",
  "ops": [
    {
      "id": "pek-std-ops/InferenceController",
      "attributes": {}
    },
    {
      "id": "pek-std-ops/GenericImagePreprocess",
      "attributes": {
        "inputImageTensorIndex": 0,
        "inputImageSourceName": "pipelineVideoFrame"
      }
    },
    {
      "id": "pek-onnx-ops/Inference",
      "attributes": {
        "modelDescriptor": "/work/config/models/modnet/model.json"
      }
    },
    {
      "id": "pek-std-ops/GenericPostprocess",
      "attributes": {
        "parser": "ModNetSegmentationParser",
        "thresholdLow": 0.2,
        "thresholdHigh": 0.8
      }
    }
  ]
}