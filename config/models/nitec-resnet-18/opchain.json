{
  "version": "3.0.0",
  "name": "NitecResnet18Int8",
  "displayName": "NITEC ResNet-18 INT8",
  "task": "Camera contact",
  "runtime": "ONNX",
  "description": "Detects camera contact from human-face crops.",
  "ops": [
    {"id": "opk-std-ops/InferenceController", "role": "controller", "instanceId": "opk-std-ops-InferenceController-0", "loopId": 1, "attributes": {"sourceProducer": ""}},
    {"id": "opk-std-ops/GenericImagePreprocess", "role": "image-preprocess", "loopId": 1, "attributes": {"inputImageTensorIndex": 0, "inputImageSourceName": "pipelineVideoFrame"}},
    {"id": "opk-onnx-ops/Inference", "role": "inference", "loopId": 1, "attributes": {"modelDescriptor": "model.json", "intraOpNumThreads": 3, "interOpNumThreads": 1}},
    {"id": "opk-std-ops/GenericPostprocess", "role": "postprocess", "instanceId": "opk-std-ops-GenericPostprocess-0", "loopId": 1, "attributes": {"parser": "CameraContactParser", "contactClassIndex": 1, "noContactClassIndex": 0}}
  ]
}
