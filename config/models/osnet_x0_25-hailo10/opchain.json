{
    "name": "OsnetX025Reid HAILO",
    "description": "Hailo 10-compiled ReID model that generates embeddings for detected objects so they can be matched across frames. Depends on YoloV11 for object boxes; YoloV11 is kept running internally when this model is enabled.",
    "ops": [
        {
            "id": "pek-std-ops/InferenceController",
            "attributes": {
                "contentType": "genericObject"
            }
        },
        {
            "id": "pek-std-ops/GenericImagePreprocess",
            "attributes": {
                "inputImageTensorIndex": 0,
                "inputImageSourceName": "pipelineVideoFrame"
            }
        },
        {
            "id": "pek-hailort-ops/Inference",
            "attributes": {
                "modelDescriptor": "/work/config/models/osnet_x0_25-hailo10/model.json"
            }
        },
        {
            "id": "pek-std-ops/GenericPostprocess",
            "attributes": {
                "parser": "ObjectEmbeddingParser"
            }
        }
    ]
}
