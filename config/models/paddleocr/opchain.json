{
	"version": "1.0.1",
	"name": "PadleOCR",
	"displayName": "PaddleOCR",
	"task": "Text detection",
	"runtime": "ONNX",
	"description": "Optical Character Recognition (OCR) model for text detection, based on the PaddleOCR framework.",
	"ops": [
		{
			"id": "opk-std-ops/InferenceController",
			"attributes": {}
		},
		{
			"id": "opk-std-ops/GenericImagePreprocess",
			"attributes": {
				"inputImageTensorIndex": 0,
				"inputImageSourceName": "pipelineVideoFrame"
			}
		},
		{
			"id": "opk-onnx-ops/Inference",
			"attributes": {
				"modelDescriptor": "model-detection.json"
			}
		},
		{
			"id": "opk-std-ops/GenericPostprocess",
			"attributes": {
				"parser": "PaddleOcrDetectionParser",
				"thresholdLow": 0.6,
				"thresholdHigh": 0.8,
				"gamma": 0.5
			}
		}
	]
}
