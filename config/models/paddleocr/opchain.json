{
	"name": "PadleOCR",
	"description": "Detects text regions in the video frame using PaddleOCR-style text detection. Runs independently and does not require another model.",
	"ops": [
		{
			"id": "pek-std-ops/InferenceController",
			"attributes": {}
		},
		{
			"id": "pek-std-ops/GenericImagePreprocess",
			"attributes": {
				"inputImageTensorIndex": 0,
				"inputImageSourceName": "pipelineVideoFrame"
			}
		},
		{
			"id": "pek-onnx-ops/Inference",
			"attributes": {
				"modelDescriptor": "/work/config/models/paddleocr/paddleocr-detection.json"
			}
		},
		{
			"id": "pek-std-ops/GenericPostprocess",
			"attributes": {
				"parser": "PaddleOcrDetectionParser",
				"thresholdLow": 0.6,
				"thresholdHigh": 0.8,
				"gamma": 0.5
			}
		}
	]
}
