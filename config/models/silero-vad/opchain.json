{
  "version": "1.3.1",
  "name": "SileroVad",
  "displayName": "Silero VAD",
  "task": "Voice activity detection",
  "runtime": "ONNX",
  "description": "Detects voice activity in mono 16 kHz PCM using 512 fresh samples and 64 context samples.",
  "ops": [
    {
      "id": "opk-std-ops/GenericAudioPreprocess",
      "attributes": {
        "inputAudioTensorIndex": 0,
        "contextSampleCount": 64
      }
    },
    {
      "id": "opk-onnx-ops/Inference",
      "attributes": {
        "modelDescriptor": "model.json",
        "intraOpNumThreads": 3,
        "interOpNumThreads": 1
      }
    },
    {
      "id": "opk-std-ops/GenericPostprocess",
      "attributes": {
        "parser": "VoiceActivityParser",
        "thresholdOn": 0.6,
        "thresholdOff": 0.45,
        "attackMs": 50,
        "releaseMs": 50,
        "outputTensorIndex": 0,
        "scoreIndex": 0,
        "activation": "none"
      }
    }
  ]
}
