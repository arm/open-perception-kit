{
  "version": "1.3.0",
  "name": "SileroVadSmartTurn",
  "displayName": "VAD + SmartTurn",
  "task": "Voice activity and turn detection",
  "runtime": "ONNX",
  "description": "Run Silero every 512 samples and evaluate padded eight-second SmartTurn history during pauses after speech.",
  "ops": [
    {
      "id": "opk-std-ops/GenericAudioPreprocess",
      "attributes": {
        "inputAudioTensorIndex": 0,
        "contextSampleCount": 64
      }
    },
    {
      "id": "opk-onnx-ops/Inference",
      "attributes": {
        "modelDescriptor": "../silero-vad/model.json"
      }
    },
    {
      "id": "opk-std-ops/GenericPostprocess",
      "attributes": {
        "parser": "SileroVadParser",
        "thresholdOn": 0.6,
        "thresholdOff": 0.45,
        "attackMs": 50,
        "releaseMs": 50
      }
    },
    {
      "id": "opk-std-ops/TurnDetector",
      "attributes": {
        "hopSampleCount": 512,
        "silenceMs": 700,
        "retryMs": 500,
        "maxAttempts": 3,
        "vadModel": "silero-vad"
      }
    },
    {
      "id": "opk-onnx-ops/Inference",
      "attributes": {
        "modelDescriptor": "model.json",
        "intraOpNumThreads": 2
      }
    },
    {
      "id": "opk-std-ops/GenericPostprocess",
      "attributes": {
        "parser": "SmartTurnParser",
        "threshold": 0.5
      }
    }
  ]
}
