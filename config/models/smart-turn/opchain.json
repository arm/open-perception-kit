{
  "version": "3.0.0",
  "name": "SmartTurn",
  "displayName": "SmartTurn PCM",
  "task": "Turn detection",
  "runtime": "ONNX",
  "description": "Evaluate eight seconds of mono 16 kHz PCM and publish turn-completion probability.",
  "ops": [
    {
      "id": "opk-std-ops/GenericAudioPreprocess", "role": "audio-preprocess",
      "attributes": {
        "inputAudioTensorIndex": 0
      }
    },
    {
      "id": "opk-onnx-ops/Inference", "role": "inference",
      "attributes": {
        "modelDescriptor": "model.json",
        "intraOpNumThreads": 3,
        "interOpNumThreads": 1
      }
    },
    {
      "id": "opk-std-ops/GenericPostprocess", "role": "postprocess",
      "instanceId": "opk-std-ops-GenericPostprocess-0",
      "attributes": {
        "parser": "SmartTurnParser",
        "threshold": 0.5
      }
    }
  ]
}
