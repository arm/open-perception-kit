{
  "version": "3.0.0",
  "name": "UltraFaceRfb320Mlwl",
  "displayName": "UltraFace RFB-320 FP32",
  "task": "Face detection",
  "runtime": "MLWL",
  "description": "Runs the FP32 VGF export with OPK-compatible score and box heads.",
  "ops": [
    {"id": "opk-std-ops/InferenceController", "role": "controller", "attributes": {}},
    {"id": "opk-std-ops/GenericImagePreprocess", "role": "image-preprocess", "attributes": {"inputImageTensorIndex": 0, "inputImageSourceName": "pipelineVideoFrame"}},
    {"id": "opk-mlwl-ops/Inference", "role": "inference", "attributes": {"modelDescriptor": "model.json"}},
    {"id": "opk-std-ops/GenericPostprocess", "role": "postprocess", "instanceId": "opk-std-ops-GenericPostprocess-0", "attributes": {"parser": "UltrafaceParser", "normalizeOutputCoordinates": false, "confidenceThreshold": 0.7, "iouThreshold": 0.3}}
  ]
}
