{
  "version": "3.0.0",
  "name": "UltraFaceRfb320Int8",
  "displayName": "UltraFace RFB-320 INT8",
  "task": "Face detection",
  "runtime": "ONNX",
  "description": "Runs the Arm-optimized UltraFace RFB-320 INT8 face detector.",
  "ops": [
    {"id": "opk-std-ops/InferenceController", "role": "controller", "attributes": {}},
    {"id": "opk-std-ops/GenericImagePreprocess", "role": "image-preprocess", "attributes": {"inputImageTensorIndex": 0, "inputImageSourceName": "pipelineVideoFrame"}},
    {"id": "opk-onnx-ops/Inference", "role": "inference", "attributes": {"modelDescriptor": "model.json", "intraOpNumThreads": 2, "interOpNumThreads": 1}},
    {"id": "opk-std-ops/GenericPostprocess", "role": "postprocess", "instanceId": "opk-std-ops-GenericPostprocess-0", "attributes": {"parser": "UltrafaceParser", "normalizeOutputCoordinates": false, "confidenceThreshold": 0.5, "iouThreshold": 0.3, "scoresAreLogits": true}}
  ]
}
