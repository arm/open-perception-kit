{
  "version": "1.0.0",
  "name": "Yolo26n320Mlwl",
  "displayName": "YOLO26n FP32 (320x320)",
  "task": "Object detection",
  "runtime": "MLWL",
  "description": "Runs the VGF detector with host-side TopK selection.",
  "ops": [
    {"id": "opk-std-ops/InferenceController", "attributes": {}},
    {"id": "opk-std-ops/GenericImagePreprocess", "attributes": {"inputImageTensorIndex": 0, "inputImageSourceName": "pipelineVideoFrame"}},
    {"id": "opk-mlwl-ops/Inference", "attributes": {"modelDescriptor": "model.json"}},
    {"id": "opk-std-ops/GenericPostprocess", "attributes": {
      "parser": "YoloParser", "outputFormat": "cornerClassScores", "maxDetections": 300,
      "normalizeOutputCoordinates": false, "applyNms": false, "confidenceThreshold": 0.4
    }}
  ]
}
