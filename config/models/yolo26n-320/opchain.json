{
  "version": "3.0.0",
  "name": "Yolo26n320Int8",
  "displayName": "YOLO26n INT8 (320x320)",
  "task": "Object detection",
  "runtime": "ONNX",
  "description": "Runs the Arm-optimized YOLO26n INT8 object detector at 320x320.",
  "ops": [
    {
      "id": "opk-std-ops/InferenceController", "role": "controller",
      "attributes": {}
    },
    {
      "id": "opk-std-ops/GenericImagePreprocess", "role": "image-preprocess",
      "attributes": {
        "inputImageTensorIndex": 0,
        "inputImageSourceName": "pipelineVideoFrame"
      }
    },
    {
      "id": "opk-onnx-ops/Inference", "role": "inference",
      "attributes": {
        "modelDescriptor": "model.json",
        "intraOpNumThreads": 2,
        "interOpNumThreads": 2
      }
    },
    {
      "id": "opk-std-ops/GenericPostprocess", "role": "postprocess",
      "instanceId": "opk-std-ops-GenericPostprocess-0",
      "attributes": {
        "parser": "YoloParser",
        "outputFormat": "cornerScoreClass",
        "normalizeOutputCoordinates": false,
        "applyNms": false,
        "confidenceThreshold": 0.4
      }
    }
  ]
}
