{
	"name": "YoloV11 HAILO",
	"description": "Hailo 8L-compiled object detector that reports bounding boxes, class labels, and confidence scores. Required by OsnetX025Reid when ReID is enabled.",
	"ops": [
		{
			"id": "pek-std-ops/InferenceController",
			"attributes": {}
		},
		{
			"id": "pek-std-ops/GenericImagePreprocess",
			"attributes": {
				"inputImageTensorIndex": 0,
				"inputImageSourceName": "pipelineVideoFrame"
			}
		},
		{
			"id": "pek-hailort-ops/Inference",
			"attributes": {
				"modelDescriptor": "/work/config/models/yolov11-hailo8l/model.json"
			}
		},
		{
			"id": "pek-std-ops/GenericPostprocess",
			"attributes": {
				"applyNms": false,
				"parser": "YoloParser",
				"outputFormat": "HailoYoloNMS",
				"normalizeOutputCoordinates": false,
				"coordinatesAreNormalized": true,
				"confidenceThreshold": 0.5,
				"maxDetections": 50,
				"classCount": 80,
				"maxBboxesPerClass": 100,
				"coordOrder": "yxyx",
				"debug": false
			}
		}
	]
}
