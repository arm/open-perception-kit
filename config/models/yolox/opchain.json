{
	"name": "yolox",
	"description": "yolox object detection model.",
	"ops": [
		{
			"id": "pek-std-ops/InferenceController",
			"attributes": {}
		},
		{
			"id": "pek-std-ops/GenericImagePreprocess",
			"attributes": {
				"inputImageTensorIndex": 0,
				"inputImageSourceName": "pipelineVideoFrame"
			}
		},
		{
			"id": "pek-executorch-ops/Inference",
			"attributes": {
				"modelDescriptor": "/work/config/models/yolox/model.json"
			}
		},
		{
			"id": "pek-std-ops/GenericPostprocess",
			"attributes": {
				"parser": "YoloXParser",
				"decoded": false,
				"scoresAreLogits": false,
				"scoreMode": "classOnly",
					"normalizeOutputCoordinates": false,
					"applyNms": true,
					"maxDetections": 16,
				"confidenceThreshold": 0.7,
				"iouThreshold": 0.45
			}
		}
	]
}
