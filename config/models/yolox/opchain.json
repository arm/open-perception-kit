{
	"version": "1.0.1",
	"name": "yolox",
	"displayName": "YOLOX Nano",
	"task": "Object detection",
	"runtime": "ExecuTorch",
	"description": "yolox object detection model.",
	"ops": [
		{
			"id": "opk-std-ops/InferenceController",
			"attributes": {}
		},
		{
			"id": "opk-std-ops/GenericImagePreprocess",
			"attributes": {
				"inputImageTensorIndex": 0,
				"inputImageSourceName": "pipelineVideoFrame"
			}
		},
		{
			"id": "opk-executorch-ops/Inference",
			"attributes": {
				"modelDescriptor": "model.json"
			}
		},
		{
			"id": "opk-std-ops/GenericPostprocess",
			"attributes": {
				"parser": "YoloXParser",
				"decoded": false,
				"scoresAreLogits": false,
				"scoreMode": "classOnly",
					"normalizeOutputCoordinates": false,
					"applyNms": true,
					"maxDetections": 16,
				"confidenceThreshold": 0.7,
				"iouThreshold": 0.45
			}
		}
	]
}
