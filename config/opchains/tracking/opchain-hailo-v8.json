{
    "name": "FullTrackingHailo8",
    "displayName": "YOLOv11n + OSNet x0.25",
    "task": "Object tracking",
    "runtime": "Hailo 8",
    "description": "Detector + ReID micropipeline for `pektracker` using Hailo 8-compiled models.",
    "ops": [
        {
            "id": "pek-std-ops/InferenceController",
            "attributes": {}
        },
        {
            "id": "pek-std-ops/GenericImagePreprocess",
            "attributes": {
                "inputImageTensorIndex": 0,
                "inputImageSourceName": "pipelineVideoFrame"
            }
        },
        {
            "id": "pek-hailort-ops/Inference",
            "attributes": {
                "modelDescriptor": "/work/config/models/yolov11-hailo8/model.json"
            }
        },
        {
            "id": "pek-std-ops/GenericPostprocess",
            "attributes": {
                "applyNms": false,
                "parser": "YoloParser",
                "outputFormat": "HailoYoloNMS",
                "normalizeOutputCoordinates": false,
                "coordinatesAreNormalized": true,
                "confidenceThreshold": 0.5,
                "maxDetections": 50,
                "classCount": 80,
                "maxBboxesPerClass": 100,
                "coordOrder": "yxyx",
                "debug": false
            }
        },
        {
            "id": "pek-std-ops/InferenceController",
            "attributes": {
                "contentType": "genericObject"
            }
        },
        {
            "id": "pek-std-ops/GenericImagePreprocess",
            "attributes": {
                "inputImageTensorIndex": 0,
                "inputImageSourceName": "pipelineVideoFrame"
            }
        },
        {
            "id": "pek-hailort-ops/Inference",
            "attributes": {
                "modelDescriptor": "/work/config/models/osnet_x0_25-hailo8/model.json"
            }
        },
        {
            "id": "pek-std-ops/GenericPostprocess",
            "attributes": {
                "parser": "ObjectEmbeddingParser"
            }
        }
    ]
}
