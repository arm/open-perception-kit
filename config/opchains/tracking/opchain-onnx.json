{
    "name": "FullTrackingOnnx",
    "displayName": "YOLOv11n + OSNet x0.25",
    "task": "Object tracking",
    "runtime": "ONNX",
    "description": "Detector + ReID micropipeline for `pektracker`.",
    "ops": [
        {
            "id": "pek-std-ops/InferenceController",
            "attributes": {}
        },
        {
            "id": "pek-std-ops/GenericImagePreprocess",
            "attributes": {
                "inputImageTensorIndex": 0,
                "inputImageSourceName": "pipelineVideoFrame"
            }
        },
        {
            "id": "pek-onnx-ops/Inference",
            "attributes": {
                "modelDescriptor": "/work/config/models/yolov11/model.json"
            }
        },
        {
            "id": "pek-std-ops/GenericPostprocess",
            "attributes": {
                "parser": "YoloParser",
                "normalizeOutputCoordinates": false,
                "applyNms": true,
                "confidenceThreshold": 0.25,
                "iouThreshold": 0.45
            }
        },
        {
            "id": "pek-std-ops/InferenceController",
            "attributes": {
                "contentType": "genericObject"
            }
        },
        {
            "id": "pek-std-ops/GenericImagePreprocess",
            "attributes": {
                "inputImageTensorIndex": 0,
                "inputImageSourceName": "pipelineVideoFrame"
            }
        },
        {
            "id": "pek-onnx-ops/Inference",
            "attributes": {
                "modelDescriptor": "/work/config/models/osnet_x0_25/model.json"
            }
        },
        {
            "id": "pek-std-ops/GenericPostprocess",
            "attributes": {
                "parser": "ObjectEmbeddingParser"
            }
        }
    ]
