{
  "description": "Every available ONNX model with the Raspberry Pi camera source and peksink video sink.",
  "pipeline": [
    "libcamerasrc !",
    "video/x-raw,format=RGB,width=1536,height=864,framerate=60/1 !",
    "videoconvert ! video/x-raw,format=BGRA !",
    "pekinfer opchain-path=${PEK_PROJECT_ROOT:-/work}/config/models/ultraface/opchain.json active=false !",
    "pekinfer opchain-path=${PEK_PROJECT_ROOT:-/work}/config/models/yolov11/opchain.json active=true !",
    "pekinfer opchain-path=${PEK_PROJECT_ROOT:-/work}/config/models/cam-contact/opchain.json active=false !",
    "pekinfer opchain-path=${PEK_PROJECT_ROOT:-/work}/config/models/gaze-detection/opchain.json active=false !",
    "pekinfer opchain-path=${PEK_PROJECT_ROOT:-/work}/config/models/mobilenetv2/opchain.json active=false !",
    "pekinfer opchain-path=${PEK_PROJECT_ROOT:-/work}/config/models/modnet/opchain.json active=false !",
    "pekinfer opchain-path=${PEK_PROJECT_ROOT:-/work}/config/models/osnet_x0_25/opchain.json active=false !",
    "pekinfer opchain-path=${PEK_PROJECT_ROOT:-/work}/config/models/paddleocr/opchain.json active=false !",
    "pekinfer opchain-path=${PEK_PROJECT_ROOT:-/work}/config/models/personclassification/opchain.json active=false !",
    "pekinfer opchain-path=${PEK_PROJECT_ROOT:-/work}/config/models/rvm/opchain.json active=false !",
    "pektracker content-type=genericObject !",
    "pekperformance show-all-metrics=true x-offset=20 y-offset=20 font-size=18 alpha=0.9 update-interval=1 !",
    "pekosd enabled=true bg-image=\"${PEK_PROJECT_ROOT:-/work}/data/images/GettyImages-1298072556-thumbnail.jpg\" !",
    "peksink name=sink"
  ],
  "alternative-source-image": [
    "filesrc location=${PEK_PROJECT_ROOT:-/work}/data/images/GettyImages-1140581459-thumbnail.jpg !",
    "jpegdec !",
    "imagefreeze !",
    "videoconvert ! video/x-raw,format=BGRA !"
  ],
  "alternative-source-usbcam": [
    "v4l2src device=/dev/video0 ! \"image/jpeg,width=1280,height=720,framerate=60/1\"  !",
    "jpegdec !",
    "videoconvert ! video/x-raw,format=BGRA !"
  ],
  "alternative-source-raspicam": [
    "libcamerasrc !",
    "video/x-raw,format=RGB,width=1536,height=864,framerate=60/1 !",
    "videoconvert ! video/x-raw,format=BGRA !"
  ],
  "alternative-source-video": [
    "filesrc location=${PEK_PROJECT_ROOT:-/work}/data/videos/GettyImages-1298072556.mov !",
    "decodebin !",
    "videoconvert !",
    "video/x-raw,format=BGRA !"
  ],
  "alternative-sink": [
    "filesink location=${PEK_PROJECT_ROOT:-/work}/data/output/full-dev.mp4"
  ],
  "alternative-sink-peksink-with-audio": [
    "peksink name=sink",
    "alsasrc device=hw:2,0 do-timestamp=true !",
    "audioconvert ! audioresample !",
    "audio/x-raw,rate=48000,channels=2 !",
    "sink.audiosink"
  ]
}
