{
  "description": "CrowdCount tracking pipeline using the ONNX tracker, pekcomm WebSocket metadata on port 8080, and peksink video output.",
  "pipeline": [
    "filesrc location=/work/data/videos/GettyImages-1465682313.mov !",
    "decodebin !",
    "videoconvert !",
    "video/x-raw,format=BGRA !",
    "pekinfer opchain-path=/work/config/opchains/tracking/opchain-onnx.json active=true !",
    "pektracker content-type=genericObject !",
    "pekcomm method=websocket ws-port=8080 endpoint=/ws !",
    "pekperformance show-all-metrics=true x-offset=20 y-offset=20 font-size=18 alpha=0.9 update-interval=1 !",
    "pekosd enabled=true !",
    "peksink name=sink"
  ],
  "alternative-source-image": [
    "filesrc location=/work/data/images/GettyImages-1465682313-thumbnail.jpg !",
    "jpegdec !",
    "imagefreeze !",
    "videoconvert ! video/x-raw,format=BGRA !"
  ],
  "alternative-source-usbcam": [
    "v4l2src device=/dev/video0 ! \"image/jpeg,width=1280,height=720,framerate=60/1\" !",
    "jpegdec !",
    "videoconvert ! video/x-raw,format=BGRA !"
  ],
  "alternative-source-video": [
    "filesrc location=/work/data/videos/GettyImages-1140581459.mov !",
    "decodebin !",
    "videoconvert !",
    "video/x-raw,format=BGRA !"
  ]
}
