{
  "description": "CrowdCount tracking pipeline using /dev/video0, the ONNX tracker, pekcomm WebSocket metadata, and peksink video output.",
  "pipeline": [
    "v4l2src device=/dev/video0 ! \"image/jpeg,width=1280,height=720,framerate=30/1\" !",
    "jpegdec !",
    "videoconvert ! video/x-raw,format=BGRA !",
    "pekinfer opchain-path=/work/config/opchains/tracking/opchain-hailo-v10.json active=true !",
    "pektracker content-type=genericObject !",
    "pekperformance show-all-metrics=true x-offset=20 y-offset=20 font-size=18 alpha=0.9 update-interval=1 !",
    "pekcomm method=websocket endpoint=/ws !",
    "pekosd enabled=true !",
    "peksink name=sink"
  ],
  "alternative-source-video": [
    "filesrc location=/work/data/videos/GettyImages-1140581459.mov !",
    "decodebin !",
    "videoconvert !",
    "video/x-raw,format=BGRA !"
  ],
  "alternative-source-image": [
    "filesrc location=/work/data/images/GettyImages-1465682313-thumbnail.jpg !",
    "jpegdec !",
    "imagefreeze !",
    "videoconvert ! video/x-raw,format=BGRA !"
  ]
}