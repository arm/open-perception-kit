    "ampinfer opchain-path=/work/config/opchains/gazedetection/opchain.json active=false !",
    "ampinfer opchain-path=/work/config/opchains/mobilenetv2/opchain.json active=false !",
    "ampinfer opchain-path=/work/config/opchains/modnet/opchain.json active=false !",
    "ampinfer opchain-path=/work/config/opchains/rvm/opchain.json active=false !",
    "ampinfer opchain-path=/work/config/opchains/cam_contact/opchain.json active=false !",
