{
    "version": "1.0.1",
    "description": "PipeWire pipeline",
    "pipeline": [
        "pipewiresrc do-timestamp=true ${PW_TARGET_OBJECT_ARG:-} !",
        "video/x-raw,format=${PW_CAPS_FORMAT:-YUY2},width=${PW_CAPS_WIDTH:-640},height=${PW_CAPS_HEIGHT:-480},framerate=${PW_CAPS_FRAMERATE:-30}/1 !",
        "videoconvert ! video/x-raw,format=BGRA !",
        "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/yolov11/opchain.json\" active=true !",
        "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/ultraface/opchain.json\" active=true !",
        "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/personclassification/opchain.json\" active=true !",
        "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/gaze-detection/opchain.json\" active=true !",
        "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/mobilenetv2/opchain.json\" active=true !",
        "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/modnet/opchain.json\" active=false !",
        "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/rvm/opchain.json\" active=true !",
        "opkperformance show-all-metrics=true update-interval=1 !",
        "opkosd enabled=true !",
        "opksink name=sink"
    ]
}
