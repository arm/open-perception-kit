{
    "description": "PipeWire pipeline",
    "pipeline": [
        "pipewiresrc do-timestamp=true ${PW_TARGET_OBJECT_ARG:-} !",
        "video/x-raw,format=${PW_CAPS_FORMAT:-YUY2},width=${PW_CAPS_WIDTH:-640},height=${PW_CAPS_HEIGHT:-480},framerate=${PW_CAPS_FRAMERATE:-30}/1 !",
        "videoconvert ! video/x-raw,format=BGRA !",
        "ampinfer opchain-path=/work/config/opchains/yolo/opchain.json active=true !",
        "ampinfer opchain-path=/work/config/opchains/ultraface/opchain.json active=true !",
        "ampinfer opchain-path=/work/config/opchains/personclassification/opchain.json active=true !",
        "ampinfer opchain-path=/work/config/opchains/gazedetection/opchain.json active=true !",
        "ampinfer opchain-path=/work/config/opchains/mobilenetv2/opchain.json active=true !",
        "ampinfer opchain-path=/work/config/opchains/modnet/opchain.json active=false !",
        "ampinfer opchain-path=/work/config/opchains/rvm/opchain.json active=true !",
        "ampperformance show-all-metrics=true x-offset=20 y-offset=20 font-size=18 alpha=0.9 update-interval=1 !",
        "amposd enabled=true !",
        "ampsink name=sink"
    ]
}