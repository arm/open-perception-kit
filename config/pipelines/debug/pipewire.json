{
    "description": "PipeWire pipeline",
    "pipeline": [
        "pipewiresrc do-timestamp=true ${PW_TARGET_OBJECT_ARG:-} !",
        "video/x-raw,format=${PW_CAPS_FORMAT:-YUY2},width=${PW_CAPS_WIDTH:-640},height=${PW_CAPS_HEIGHT:-480},framerate=${PW_CAPS_FRAMERATE:-30}/1 !",
        "videoconvert ! video/x-raw,format=BGRA !",
        "pekinfer opchain-path=${PEK_PROJECT_ROOT:-/work}/config/models/yolov11/opchain.json active=true !",
        "pekinfer opchain-path=${PEK_PROJECT_ROOT:-/work}/config/models/ultraface/opchain.json active=true !",
        "pekinfer opchain-path=${PEK_PROJECT_ROOT:-/work}/config/models/personclassification/opchain.json active=true !",
        "pekinfer opchain-path=${PEK_PROJECT_ROOT:-/work}/config/models/gaze-detection/opchain.json active=true !",
        "pekinfer opchain-path=${PEK_PROJECT_ROOT:-/work}/config/models/mobilenetv2/opchain.json active=true !",
        "pekinfer opchain-path=${PEK_PROJECT_ROOT:-/work}/config/models/modnet/opchain.json active=false !",
        "pekinfer opchain-path=${PEK_PROJECT_ROOT:-/work}/config/models/rvm/opchain.json active=true !",
        "pekperformance show-all-metrics=true x-offset=20 y-offset=20 font-size=18 alpha=0.9 update-interval=1 !",
        "pekosd enabled=true !",
        "peksink name=sink"
    ]
}
