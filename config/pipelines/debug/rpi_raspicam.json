{
  "description": "Test Raspberry pipeline",
  "pipeline": [
    "libcamerasrc camera-name=\"/base/axi/pcie@1000120000/rp1/i2c@80000/imx708@1a\" !",
    "video/x-raw,format=RGB,width=1536,height=864,framerate=60/1 !",
    "videoconvert ! video/x-raw,format=BGRA !",
    "pekinfer opchain-path=${PEK_PROJECT_ROOT:-/work}/config/models/yolov11/opchain.json active=false !",
    "pekinfer opchain-path=${PEK_PROJECT_ROOT:-/work}/config/models/ultraface/opchain.json active=false !",
    "pekinfer opchain-path=${PEK_PROJECT_ROOT:-/work}/config/models/paddleocr/opchain.json active=false !",
    "pekinfer opchain-path=${PEK_PROJECT_ROOT:-/work}/config/models/mobilenetv2/opchain.json active=false !",
    "pekinfer opchain-path=${PEK_PROJECT_ROOT:-/work}/config/models/yolov11-hailo8/opchain.json active=false !",
    "pekinfer opchain-path=${PEK_PROJECT_ROOT:-/work}/config/models/personclassification/opchain.json active=false !",
    "pekinfer opchain-path=${PEK_PROJECT_ROOT:-/work}/config/models/gaze-detection/opchain.json active=false !",
    "pekperformance show-all-metrics=true x-offset=20 y-offset=20 font-size=18 alpha=0.9 update-interval=1 !",
    "pekosd enabled=true !",
    "peksink name=sink"
  ]
}