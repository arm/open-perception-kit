{
  "version": "1.0.1",
  "description": "Test Raspberry pipeline",
  "pipeline": [
    "v4l2src device=/dev/video0 ! \"image/jpeg,width=1280,height=720,framerate=60/1\"  !",
    "jpegdec !",
    "videoconvert ! video/x-raw,format=BGRA !",
    "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/cam-contact/opchain.json\" active=false !",
    "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/gaze-detection/opchain.json\" active=false !",
    "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/mobilenetv2/opchain.json\" active=false !",
    "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/modnet/opchain.json\" active=false !",
    "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/osnet_x0_25/opchain.json\" active=false !",
    "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/paddleocr/opchain.json\" active=false !",
    "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/personclassification/opchain.json\" active=false !",
    "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/rvm/opchain.json\" active=false !",
    "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/ultraface/opchain.json\" active=false !",
    "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/yolov11/opchain.json\" active=false !",
    "opktracker content-type=genericObject !",
    "opkperformance show-all-metrics=true update-interval=1 !",
    "opkosd enabled=true !",
    "opksink name=sink",
    "alsasrc device=hw:2,0 do-timestamp=true !",
    "audioconvert ! audioresample !",
    "audio/x-raw,rate=48000,channels=2 !",
    "sink.audiosink"
  ]
}
