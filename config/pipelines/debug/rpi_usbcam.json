{
  "description": "Test Raspberry pipeline",
  "pipeline": [
    "v4l2src device=/dev/video0 ! \"image/jpeg,width=1280,height=720,framerate=60/1\"  !",
    "jpegdec !",
    "videoconvert ! video/x-raw,format=BGRA !",
    "ampinfer opchain-path=/work/config/models/cam-contact/opchain.json active=false !",
    "ampinfer opchain-path=/work/config/models/gaze-detection/opchain.json active=false !",
    "ampinfer opchain-path=/work/config/models/mobilenetv2/opchain.json active=false !",
    "ampinfer opchain-path=/work/config/models/mobilenetv2-hef/opchain.json active=false !",
    "ampinfer opchain-path=/work/config/models/modnet/opchain.json active=false !",
    "ampinfer opchain-path=/work/config/models/osnet_x0_25/opchain.json active=false !",
    "ampinfer opchain-path=/work/config/models/osnet_x0_25-hef/opchain.json active=false !",
    "ampinfer opchain-path=/work/config/models/paddleocr/opchain.json active=false !",
    "ampinfer opchain-path=/work/config/models/personclassification/opchain.json active=false !",
    "ampinfer opchain-path=/work/config/models/rvm/opchain.json active=false !",
    "ampinfer opchain-path=/work/config/models/ultraface/opchain.json active=false !",
    "ampinfer opchain-path=/work/config/models/yolov11/opchain.json active=false !",
    "ampinfer opchain-path=/work/config/models/yolov11-hef/opchain.json active=false !",
    "amptracker content-type=genericObject !",
    "ampperformance show-all-metrics=true x-offset=20 y-offset=20 font-size=18 alpha=0.9 update-interval=1 !",
    "amposd enabled=true !",
    "ampsink name=sink",
    "alsasrc device=hw:2,0 do-timestamp=true !",
    "audioconvert ! audioresample !",
    "audio/x-raw,rate=48000,channels=2 !",
    "sink.audiosink"
  ]
}
