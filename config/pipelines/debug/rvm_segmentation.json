{
    "description": "RVM segmentation on woman image",
    "pipeline": [
        "filesrc location=/work/data/images/GettyImages-1140581459-thumbnail.jpg !",
        "jpegdec !",
        "imagefreeze !",
        "videoconvert ! video/x-raw,format=BGRA !",
        "pekinfer opchain-path=/work/config/models/rvm/opchain.json active=true !",
        "pekperformance show-all-metrics=true x-offset=20 y-offset=20 font-size=18 alpha=0.9 update-interval=1 !",
        "pekosd enabled=false bg-image=\"/work/data/images/GettyImages-1140581459-thumbnail.jpg\" !",
        "peksink name=sink"
    ]
}