{
    "version": "1.0.1",
    "description": "RVM segmentation on woman image",
    "pipeline": [
        "filesrc location=\"${OPK_PROJECT_ROOT:-/work}/data/images/GettyImages-1140581459-thumbnail.jpg\" !",
        "jpegdec !",
        "imagefreeze !",
        "videoconvert ! video/x-raw,format=BGRA !",
        "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/rvm/opchain.json\" active=true !",
        "opkperformance show-all-metrics=true update-interval=1 !",
        "opkosd enabled=true bg-image=\"${OPK_PROJECT_ROOT:-/work}/data/images/GettyImages-1140581459-thumbnail.jpg\" !",
        "opksink name=sink"
    ]
}
