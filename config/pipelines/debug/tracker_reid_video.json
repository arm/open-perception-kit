{
    "version": "1.0.1",
    "description": "Test tracker with YOLO + OSNet ReID on video",
    "pipeline": [
        "filesrc location=\"${OPK_PROJECT_ROOT:-/work}/data/videos/GettyImages-1298072556.mov\" !",
        "decodebin !",
        "videoconvert !",
        "video/x-raw,format=BGRA !",
        "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/yolov11/opchain.json\" active=true !",
        "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/osnet_x0_25/opchain.json\" active=true !",
        "opktracker content-type=genericObject !",
        "opkosd enabled=true !",
        "opkcomm method=file file-name=${OPKCOMM_FILE:-/tmp/opkcomm} !",
        "opksink name=sink"
    ]
}
