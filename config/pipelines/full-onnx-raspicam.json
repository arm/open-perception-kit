{
  "version": "1.0.2",
  "description": "All supported ONNX models on a Raspberry Pi camera, with YOLO26n-320 enabled by default.",
  "sourceInfo": "Raspberry Pi camera required",
  "pipeline": [
    "libcamerasrc !",
    "video/x-raw,format=RGB,width=1536,height=864,framerate=60/1 !",
    "videoconvert ! video/x-raw,format=BGRA !",
    "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/ultraface-rfb-320/opchain.json\" active=false !",
    "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/yolo26n-320/opchain.json\" active=true !",
    "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/yolo26n-480/opchain.json\" active=false !",
    "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/yolo26n-640/opchain.json\" active=false !",
    "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/yolo26s-320/opchain.json\" active=false !",
    "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/yolo26s-480/opchain.json\" active=false !",
    "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/yolo26s-640/opchain.json\" active=false !",
    "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/osnet-x0-25/opchain.json\" active=false !",
    "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/nitec-resnet-18/opchain.json\" active=false !",
    "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/mobilegaze-mobilenet-v2/opchain.json\" active=false !",
    "opktracker content-type=genericObject !",
    "opkperformance show-all-metrics=true update-interval=1 !",
    "opkcomm method=websocket endpoint=/ws !",
    "videorate drop-only=true ! videoscale !",
    "video/x-raw,format=BGRA,width=960,height=540,framerate=24/1 !",
    "opksink name=sink"
  ],
  "alternative-source-image": [
    "filesrc location=\"${OPK_PROJECT_ROOT:-/work}/data/images/GettyImages-1140581459-thumbnail.jpg\" !",
    "jpegdec !",
    "imagefreeze !",
    "videoconvert ! video/x-raw,format=BGRA !"
  ],
  "alternative-source-usbcam": [
    "v4l2src device=/dev/video0 ! \"image/jpeg,width=1280,height=720,framerate=60/1\" !",
    "jpegdec !",
    "videoconvert ! video/x-raw,format=BGRA !"
  ],
  "alternative-source-raspicam": [
    "libcamerasrc !",
    "video/x-raw,format=RGB,width=1536,height=864,framerate=60/1 !",
    "videoconvert ! video/x-raw,format=BGRA !"
  ],
  "alternative-source-video": [
    "filesrc location=\"${OPK_PROJECT_ROOT:-/work}/data/videos/GettyImages-1298072556.mov\" !",
    "decodebin !",
    "videoconvert !",
    "video/x-raw,format=BGRA !"
  ],
  "alternative-sink": [
    "filesink location=\"${OPK_PROJECT_ROOT:-/work}/data/output/full-dev.mp4\""
  ],
  "alternative-sink-opksink-with-audio": [
    "opksink name=sink",
    "alsasrc device=hw:2,0 do-timestamp=true !",
    "audioconvert ! audioresample !",
    "audio/x-raw,rate=48000,channels=2 !",
    "sink.audiosink"
  ]
}
