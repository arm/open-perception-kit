{
  "version": "1.0.0",
  "description": "MLWL VGF GPU demo: YOLO26n object detection and UltraFace face detection.",
  "sourceInfo": "bundled video file",
  "loop": true,
  "pipeline": [
    "filesrc location=\"${OPK_PROJECT_ROOT:-/work}/data/videos/GettyImages-1140581459.mov\" !",
    "decodebin !",
    "videoconvert !",
    "video/x-raw,format=BGRA !",
    "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/ultraface-rfb-320-mlwl/opchain-gpu.json\" active=true !",
    "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/yolo26n-320-mlwl/opchain-gpu.json\" active=true !",
    "opktracker content-type=genericObject !",
    "opkperformance show-all-metrics=true update-interval=1 !",
    "opkcomm method=websocket endpoint=/ws !",
    "opksink name=sink webrtc-frame-timeout-ms=120000"
  ]
}
