{
  "version": "1.0.1",
  "description": "MLWL VGF demo: YOLO26n object detection and UltraFace face detection.",
  "sourceInfo": "bundled video file",
  "loop": true,
  "pipeline": [
    "filesrc location=\"${OPK_PROJECT_ROOT:-/work}/data/videos/GettyImages-1140581459.mov\" !",
    "decodebin !",
    "videoconvert !",
    "video/x-raw,format=BGRA !",
    "opkinfer name=opkinfer0 opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/ultraface-rfb-320-mlwl/opchain.json\" active=true !",
    "opkinfer name=opkinfer1 opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/yolo26n-320-mlwl/opchain.json\" active=true !",
    "opktracker input-producers=\"[\\\"opkinfer1/opk-std-ops-GenericPostprocess-0\\\"]\" !",
    "opkperformance show-all-metrics=true update-interval=1 !",
    "opkcomm method=websocket endpoint=/ws !",
    "opksink name=sink"
  ]
}
