{
  "version": "1.0.2",
  "description": "MobileNetV2 ONNX classification on bundled image with C++ and Python results, WebSocket metadata, and opksink video sink.",
  "sourceInfo": "image file",
  "loop": false,
  "pipeline": [
    "filesrc location=/work/data/images/GettyImages-2222093886-thumbnail.jpg !",
    "jpegdec !",
    "imagefreeze is-live=true !",
    "videoconvert !",
    "videoscale !",
    "video/x-raw,format=BGRA,width=1280,height=720,framerate=20/1 !",
    "opkinfer opchain-path=/work/config/models/mobilenetv2/opchain-python-classification.json active=true !",
    "opkperformance show-all-metrics=true update-interval=1 !",
    "opkcomm method=websocket endpoint=/ws !",
    "opksink name=sink"
  ]
}
