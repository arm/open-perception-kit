{
  "description": "MobileNetV2 ONNX classification with comparable C++ and stateful Python labels plus runtime performance metrics.",
  "pipeline": [
    "videotestsrc is-live=true pattern=ball !",
    "videoconvert !",
    "videoscale !",
    "video/x-raw,format=BGRA,width=1280,height=720,framerate=20/1 !",
    "pekinfer opchain-path=/work/config/models/mobilenetv2/opchain-python-overlay.json active=true !",
    "pekperformance show-all-metrics=true update-interval=1 !",
    "pekcomm method=websocket endpoint=/ws !",
    "pekosd enabled=true performance-overlay-enabled=true !",
    "peksink name=sink"
  ]
}
