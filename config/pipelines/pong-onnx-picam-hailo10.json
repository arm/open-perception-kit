{
  "description": "Every available ONNX and Hailo model with the default video source and peksink video and audio sink.",
  "agentReviewSuppressionFacePongInactiveModelBegin": "<agent-review:suppress-begin> Face Pong intentionally registers the Hailo 10 face embedding model with active=false; users enable it from the PEK web viewer AI Models panel, and manual model enablement is acceptable for this demo.",
  "pipeline": [
    "libcamerasrc camera-name=\"/base/axi/pcie@1000120000/rp1/i2c@88000/imx708@1a\" !",
    "video/x-raw,format=RGB,width=640,height=360,framerate=54/1 !",
    "videoconvert ! video/x-raw,format=BGRA !",
    "pekinfer opchain-path=/work/config/opchains/face-embedding/opchain-hailo10.json active=false !",
    "pektracker content-type=humanFace use-embeddings=true association-mode=embedding use-kalman=false emit-predicted-detections=false emit-trace=false !",
    "pekperformance show-all-metrics=true x-offset=20 y-offset=20 font-size=18 alpha=0.9 update-interval=1 !",
    "pekcomm method=websocket !",
    "pekosd enabled=false bg-image=\"/work/data/images/GettyImages-1298072556-thumbnail.jpg\" !",
    "peksink name=sink"
  ],
  "agentReviewSuppressionFacePongInactiveModelEnd": "<agent-review:suppress-end>",
  "alternative-source-image": [
    "filesrc location=/work/data/images/GettyImages-1140581459-thumbnail.jpg !",
    "jpegdec !",
    "imagefreeze !",
    "videoconvert ! video/x-raw,format=BGRA !"
  ],
  "alternative-source-usbcam": [
    "v4l2src device=/dev/video0 ! \"image/jpeg,width=1280,height=720,framerate=60/1\"  !",
    "jpegdec !",
    "videoconvert ! video/x-raw,format=BGRA !"
  ],
  "alternative-source-raspicam": [
    "libcamerasrc camera-name=\"/base/axi/pcie@1000120000/rp1/i2c@80000/imx708@1a\" !",
    "video/x-raw,format=RGB,width=1536,height=864,framerate=60/1 !",
    "videoconvert ! video/x-raw,format=BGRA !"
  ],
  "alternative-source-video": [
    "filesrc location=/work/data/videos/GettyImages-1298072556.mov !",
    "decodebin !",
    "videoconvert !",
    "video/x-raw,format=BGRA !"
  ],
  "alternative-sink-file": [
