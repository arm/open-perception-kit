{
  "version": "1.0.1",
  "description": "Switch between all four RetinaFace and gaze combinations in the WebUI; enable one face detector and one gaze model at a time.",
  "sourceInfo": "bundled video file",
  "loop": true,
  "pipeline": [
    "filesrc location=\"${OPK_PROJECT_ROOT:-/work}/data/videos/GettyImages-1129703310.mov\" !",
    "decodebin ! videoconvert ! video/x-raw,format=BGRA !",
    "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/retinaface-resnet34/opchain-1080x1080.json\" active=true !",
    "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/retinaface-resnet34/opchain-1920x1080.json\" active=false !",
    "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/gaze-resnet34/opchain.json\" auto-activate-dependencies=false active=true !",
    "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/models/gaze-resnet50/opchain.json\" auto-activate-dependencies=false active=false !",
    "opkperformance show-all-metrics=true update-interval=1 !",
    "opkcomm method=websocket endpoint=/ws !",
    "videorate drop-only=true ! videoscale !",
    "video/x-raw,format=BGRA,width=960,height=540,framerate=24/1 !",
    "opksink name=sink"
  ]
}
