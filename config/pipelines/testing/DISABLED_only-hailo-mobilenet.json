{
  "description": "Test the hailo mobilenet plugin with a simple pipeline that decodes a JPEG image, runs inference on the mobilenetv2 model, and sends the output to a fakesink.",
  "pipeline": [
    "filesrc location=\"${PEK_PROJECT_ROOT:-/work}/data/images/GettyImages-1140581459-thumbnail.jpg\" !",
    "jpegdec !",
    "imagefreeze num-buffers=${NUM_FRAMES:-30} !",
    "videoconvert ! video/x-raw,format=BGRA,framerate=30/1 !",
    "pekinfer opchain-path=\"${PEK_PROJECT_ROOT:-/work}/config/models/mobilenetv2-hailo8/opchain.json\" active=true !",
    "fakesink sync=true"
  ]
}