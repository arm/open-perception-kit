{
  "version": "1.0.1",
  "description": "Test the gaze-detection pipeline with a simple pipeline that decodes a JPEG image, runs inference, and sends the output to a fakesink.",
  "pipeline": [
    "filesrc location=\"${OPK_PROJECT_ROOT:-/work}/data/images/GettyImages-1140581459-thumbnail.jpg\" !",
    "jpegdec !",
    "imagefreeze num-buffers=${NUM_FRAMES:-30} !",
    "videoconvert ! video/x-raw,format=BGRA,framerate=30/1 !",
    "opkinfer opchain-path=\"${OPK_PROJECT_ROOT:-/work}/config/opchains/gaze-detection/opchain.json\" active=true !",
    "fakesink sync=true"
  ]
}
