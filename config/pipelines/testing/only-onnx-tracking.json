{
  "description": "Test the ONNX tracking pipeline with a simple pipeline that decodes a JPEG image, runs inference and tracking, and sends the output to a fakesink.",
  "pipeline": [
    "filesrc location=/work/data/images/katana.jpg !",
    "jpegdec !",
    "imagefreeze num-buffers=${NUM_FRAMES:-30} !",
    "videoconvert ! video/x-raw,format=BGRA,framerate=30/1 !",
    "pekinfer opchain-path=/work/config/opchains/tracking/opchain-onnx.json active=true !",
    "pektracker content-type=genericObject !",
    "fakesink sync=true"
  ]
}
