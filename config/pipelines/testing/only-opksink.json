{
  "version": "1.0.1",
  "description": "Test the opksink plugin with a simple pipeline that decodes a JPEG image, publishes metadata, and serves the output through opksink.",
  "pipeline": [
    "filesrc location=\"${OPK_PROJECT_ROOT:-/work}/data/images/GettyImages-1140581459-thumbnail.jpg\" !",
    "jpegdec !",
    "imagefreeze num-buffers=${NUM_FRAMES:-30} !",
    "videoconvert ! video/x-raw,format=BGRA,framerate=30/1 !",
    "opkperformance show-all-metrics=true update-interval=1 !",
    "opkcomm method=websocket endpoint=/ws !",
    "opksink name=sink"
  ]
}
