{
  "description": "Test the ONNX YOLO pipeline with a simple pipeline that decodes a JPEG image, runs inference on the YOLOv11 model, and sends the output to a fakesink.",
  "pipeline": [
    "filesrc location=\"${PEK_PROJECT_ROOT:-/work}/data/images/GettyImages-1140581459-thumbnail.jpg\" !",
    "jpegdec !",
    "imagefreeze num-buffers=${NUM_FRAMES:-30} !",
    "videoconvert ! video/x-raw,format=BGRA,framerate=30/1 !",
    "pekinfer opchain-path=\"${PEK_PROJECT_ROOT:-/work}/config/models/yolov11/opchain.json\" active=true !",
    "pekinfer opchain-path=\"${PEK_PROJECT_ROOT:-/work}/config/models/ultraface/opchain.json\" active=true !",
    "pekinfer opchain-path=\"${PEK_PROJECT_ROOT:-/work}/config/opchains/gaze-detection/opchain.json\" active=true !",
    "pekinfer opchain-path=\"${PEK_PROJECT_ROOT:-/work}/config/models/mobilenetv2/opchain.json\" active=true !",
    "pekinfer opchain-path=\"${PEK_PROJECT_ROOT:-/work}/config/models/osnet_x0_25/opchain.json\" active=true !",
    "pekinfer opchain-path=\"${PEK_PROJECT_ROOT:-/work}/config/models/rvm/opchain.json\" active=true !",
    "pektracker content-type=genericObject !",
    "pekperformance show-all-metrics=true update-interval=1 !",
    "pekcomm method=websocket endpoint=/ws !",
    "peksink name=sink"
  ]
}