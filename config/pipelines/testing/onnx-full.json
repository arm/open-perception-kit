{
  "description": "Test the ONNX model pipeline with a simple pipeline that decodes a JPEG image, renders model output overlays, and streams the result to peksink.",
  "pipeline": [
    "filesrc location=/work/data/images/GettyImages-1140581459-thumbnail.jpg !",
    "jpegdec !",
    "imagefreeze num-buffers=${NUM_FRAMES:-30} !",
    "videoconvert ! video/x-raw,format=BGRA,framerate=30/1 !",
    "pekinfer opchain-path=/work/config/models/yolov11/opchain.json active=true !",
    "pekinfer opchain-path=/work/config/models/ultraface/opchain.json active=true !",
    "pekinfer opchain-path=/work/config/opchains/gaze-detection/opchain.json active=true !",
    "pekinfer opchain-path=/work/config/models/mobilenetv2/opchain.json active=true !",
    "pekinfer opchain-path=/work/config/models/osnet_x0_25/opchain.json active=true !",
    "pekinfer opchain-path=/work/config/models/rvm/opchain.json active=true !",
    "pektracker content-type=genericObject !",
    "pekosd enabled=true bg-image=\"/work/data/images/GettyImages-1298072556-thumbnail.jpg\" !",
    "peksink name=sink"
  ]
}
