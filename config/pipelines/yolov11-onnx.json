{
  "description": "YOLOv11 ONNX object detection with the default video source, WebSocket metadata streaming, tracking, and peksink video output.",
  "loop": true,
  "pipeline": [
    "filesrc location=${PEK_PROJECT_ROOT:-/work}/data/videos/GettyImages-1140581459.mov !",
    "decodebin !",
    "videoconvert !",
    "video/x-raw,format=BGRA !",
    "pekinfer opchain-path=${PEK_PROJECT_ROOT:-/work}/config/models/yolov11/opchain.json active=true !",
    "pektracker content-type=genericObject !",
    "pekperformance show-all-metrics=true x-offset=20 y-offset=20 font-size=18 alpha=0.9 update-interval=1 !",
    "pekcomm method=websocket endpoint=/ws !",
    "pekosd enabled=false bg-image=\"${PEK_PROJECT_ROOT:-/work}/data/images/GettyImages-1298072556-thumbnail.jpg\" !",
    "peksink name=sink"
  ],
  "alternative-source-image": [
    "filesrc location=${PEK_PROJECT_ROOT:-/work}/data/images/GettyImages-1140581459-thumbnail.jpg !",
    "jpegdec !",
    "imagefreeze !",
    "videoconvert ! video/x-raw,format=BGRA !"
  ],
  "alternative-source-usbcam": [
    "v4l2src device=/dev/video0 ! \"image/jpeg,width=1280,height=720,framerate=60/1\"  !",
    "jpegdec !",
    "videoconvert ! video/x-raw,format=BGRA !"
  ],
  "alternative-source-raspicam": [
    "libcamerasrc camera-name=\"/base/axi/pcie@1000120000/rp1/i2c@80000/imx708@1a\" !",
    "video/x-raw,format=RGB,width=1536,height=864,framerate=60/1 !",
    "videoconvert ! video/x-raw,format=BGRA !"
  ],
  "alternative-source-video": [
    "filesrc location=${PEK_PROJECT_ROOT:-/work}/data/videos/GettyImages-1298072556.mov !",
    "decodebin !",
    "videoconvert !",
    "video/x-raw,format=BGRA !"
  ],
  "alternative-sink": [
    "filesink location=${PEK_PROJECT_ROOT:-/work}/data/output/yolov11-onnx.mp4"
  ],
  "alternative-sink-peksink-with-audio": [
    "peksink name=sink",
    "alsasrc device=hw:2,0 do-timestamp=true !",
    "audioconvert ! audioresample !",
    "audio/x-raw,rate=48000,channels=2 !",
    "sink.audiosink"
  ]
}
