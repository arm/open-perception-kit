{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arm:pek:schema:opchain-op:v1",
  "title": "PEK OpChain operation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(?=[^/]*[^\\s/][^/]*/)(?=[^/]*/[^/]*[^\\s/][^/]*$)[^/]+/[^/]+$"
    },
    "instanceId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "loopId": {
      "type": "integer",
      "minimum": 1
    },
    "attributes": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "$ref": "urn:arm:pek:schema:inference-controller-op:v1"
    },
    {
      "$ref": "urn:arm:pek:schema:generic-image-preprocess-op:v1"
    },
    {
      "$ref": "urn:arm:pek:schema:inference-op:v1"
    },
    {
      "$ref": "urn:arm:pek:schema:generic-postprocess-op:v1"
    }
  ]
}
