{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arm:opk:schema:generic-image-preprocess-op:v1",
  "title": "GenericImagePreprocess Op v1",
  "if": {
    "properties": {
      "id": {
        "const": "opk-std-ops/GenericImagePreprocess"
      }
    },
    "required": [
      "id"
    ]
  },
  "then": {
    "properties": {
      "attributes": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "inputImageSourceName": {
            "$ref": "urn:arm:opk:schema:opchain-common:v1#/$defs/trimNonEmptyString",
            "default": "pipelineVideoFrame"
          },
          "inputImageTensorIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          }
        }
      }
    }
  }
}
