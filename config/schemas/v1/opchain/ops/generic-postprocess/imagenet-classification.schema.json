{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arm:pek:schema:generic-postprocess-parser-imagenet-classification:v1",
  "title": "ImageNetClassificationParser attributes v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "parser"
  ],
  "properties": {
    "parser": {
      "const": "ImageNetClassificationParser"
    },
    "topK": {
      "$ref": "urn:arm:pek:schema:opchain-common:v1#/$defs/positiveCount",
      "default": 5
    },
    "confidenceThreshold": {
      "$ref": "urn:arm:pek:schema:opchain-common:v1#/$defs/probability",
      "default": 0.01
    }
  }
}
