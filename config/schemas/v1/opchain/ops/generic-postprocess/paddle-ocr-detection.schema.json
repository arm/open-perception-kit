{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arm:pek:schema:generic-postprocess-parser-paddle-ocr-detection:v1",
  "title": "PaddleOcrDetectionParser attributes v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "parser"
  ],
  "properties": {
    "parser": {
      "const": "PaddleOcrDetectionParser"
    },
    "thresholdLow": {
      "$ref": "urn:arm:pek:schema:opchain-common:v1#/$defs/probability",
      "default": 0.6
    },
    "thresholdHigh": {
      "$ref": "urn:arm:pek:schema:opchain-common:v1#/$defs/probability",
      "default": 0.8
    },
    "gamma": {
      "$ref": "urn:arm:pek:schema:opchain-common:v1#/$defs/positiveFiniteFloat",
      "default": 0.5
    }
  }
}
