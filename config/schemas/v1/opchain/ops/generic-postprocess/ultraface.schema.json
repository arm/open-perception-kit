{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arm:pek:schema:generic-postprocess-parser-ultraface:v1",
  "title": "UltrafaceParser attributes v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "parser"
  ],
  "properties": {
    "parser": {
      "const": "UltrafaceParser"
    },
    "confidenceThreshold": {
      "$ref": "urn:arm:pek:schema:opchain-common:v1#/$defs/probability",
      "default": 0.5
    },
    "iouThreshold": {
      "$ref": "urn:arm:pek:schema:opchain-common:v1#/$defs/probability",
      "default": 0.3
    },
    "normalizeOutputCoordinates": {
      "type": "boolean",
      "default": true
    }
  }
}
