{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arm:pek:schema:generic-postprocess-parser-yolo-x:v1",
  "title": "YoloXParser attributes v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "parser"
  ],
  "properties": {
    "parser": {
      "const": "YoloXParser"
    },
    "classCount": {
      "$ref": "urn:arm:pek:schema:opchain-common:v1#/$defs/positiveCount",
      "default": 80
    },
    "confidenceThreshold": {
      "$ref": "urn:arm:pek:schema:opchain-common:v1#/$defs/probability",
      "default": 0.25
    },
    "iouThreshold": {
      "$ref": "urn:arm:pek:schema:opchain-common:v1#/$defs/probability",
      "default": 0.45
    },
    "maxDetections": {
      "$ref": "urn:arm:pek:schema:opchain-common:v1#/$defs/positiveCount",
      "default": 100
    },
    "applyNms": {
      "type": "boolean",
      "default": true
    },
    "decoded": {
      "type": "boolean",
      "default": false
    },
    "scoresAreLogits": {
      "type": "boolean",
      "default": false
    },
    "normalizeOutputCoordinates": {
      "type": "boolean",
      "default": true
    },
    "scoreMode": {
      "enum": [
        "objectnessClass",
        "classOnly"
      ],
      "default": "objectnessClass"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "applyNms": {
            "const": false
          }
        },
        "required": [
          "applyNms"
        ]
      },
      "then": {
        "not": {
          "required": [
            "iouThreshold"
          ]
        }
      }
    }
  ]
}
