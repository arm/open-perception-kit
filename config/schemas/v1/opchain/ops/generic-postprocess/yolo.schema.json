{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arm:pek:schema:generic-postprocess-parser-yolo:v1",
  "title": "YoloParser attributes v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "parser"
  ],
  "properties": {
    "parser": {
      "const": "YoloParser"
    },
    "outputFormat": {
      "enum": [
        "UltralyticsYolo",
        "HailoYoloNMS"
      ],
      "default": "UltralyticsYolo"
    },
    "confidenceThreshold": {
      "$ref": "urn:arm:pek:schema:opchain-common:v1#/$defs/probability",
      "default": 0.25
    },
    "iouThreshold": {
      "$ref": "urn:arm:pek:schema:opchain-common:v1#/$defs/probability",
      "default": 0.45
    },
    "coordinatesAreNormalized": {
      "type": "boolean",
      "default": false
    },
    "normalizeOutputCoordinates": {
      "type": "boolean",
      "default": true
    },
    "applyNms": {
      "type": "boolean",
      "default": true
    },
    "maxDetections": {
      "$ref": "urn:arm:pek:schema:opchain-common:v1#/$defs/positiveCount",
      "default": 5
    },
    "classCount": {
      "$ref": "urn:arm:pek:schema:opchain-common:v1#/$defs/positiveCount",
      "default": 80
    },
    "maxBboxesPerClass": {
      "$ref": "urn:arm:pek:schema:opchain-common:v1#/$defs/positiveCount",
      "default": 100
    },
    "coordOrder": {
      "enum": [
        "yxyx",
        "xyxy"
      ],
      "default": "yxyx"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "applyNms": {
            "const": false
          }
        },
        "required": [
          "applyNms"
        ]
      },
      "then": {
        "not": {
          "required": [
            "iouThreshold"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "outputFormat": {
            "const": "HailoYoloNMS"
          }
        },
        "required": [
          "outputFormat"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "classCount"
              ]
            },
            {
              "required": [
                "maxDetections"
              ]
            },
            {
              "required": [
                "maxBboxesPerClass"
              ]
            },
            {
              "required": [
                "coordOrder"
              ]
            }
          ]
        }
      }
    }
  ]
}
