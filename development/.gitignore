# ------------------------------------------------------------
# Build output
# ------------------------------------------------------------

build/

# ------------------------------------------------------------
# Meson subprojects
# ------------------------------------------------------------

# Ignore all downloaded subproject directories
subprojects/*/

# Keep wrap definitions (dependency descriptors)
!subprojects/*.wrap

# ------------------------------------------------------------
# Allow custom packagefiles overrides
# ------------------------------------------------------------

# Re-include packagefiles directory structure
!subprojects/packagefiles/
!subprojects/packagefiles/**/

# Allow specific override build files
!subprojects/packagefiles/**/meson.build