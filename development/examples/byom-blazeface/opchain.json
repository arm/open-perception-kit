{
  "version": "3.0.0",
  "name": "BYOM BlazeFace JSON",
  "displayName": "BYOM BlazeFace JSON",
  "task": "Face detection",
  "runtime": "ONNX + Python",
  "description": "BlazeFace inference with caller-owned JSON postprocessing.",
  "ops": [
    {
      "id": "opk-std-ops/InferenceController", "role": "controller",
      "attributes": {}
    },
    {
      "id": "opk-std-ops/GenericImagePreprocess", "role": "image-preprocess",
      "attributes": {
        "inputImageTensorIndex": 0,
        "inputImageSourceName": "pipelineVideoFrame"
      }
    },
    {
      "id": "opk-onnx-ops/Inference", "role": "inference",
      "attributes": {
        "modelDescriptor": "model.json"
      }
    },
    {
      "id": "opk-python-ops/PythonScript", "role": "postprocess",
      "instanceId": "blazeface-json-postprocessor",
      "attributes": {
        "script": "postprocess.py"
      }
    }
  ]
}
