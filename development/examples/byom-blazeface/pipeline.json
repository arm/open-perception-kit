{
  "version": "1.0.1",
  "description": "Run pinned BlazeFace ONNX inference and publish caller-owned JSON through FrameResults NDJSON.",
  "pipeline": [
    "filesrc location=\"${OPK_PROJECT_ROOT}/data/videos/GettyImages-1129703310.mov\" !",
    "decodebin !",
    "videoconvert !",
    "video/x-raw,format=BGRA !",
    "opkinfer opchain-path=\"${BYOM_EXAMPLE_DIR}/opchain.json\" active=true !",
    "opkcomm method=file file-name=\"${BYOM_RESULTS}\" !",
    "fakesink sync=false"
  ]
}
