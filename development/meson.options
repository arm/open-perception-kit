option('enable_asserts', type: 'boolean', value: true, description: 'Enable internal asserts')
option('tests', type: 'boolean', value: false, description: 'Build unit tests')
option('release_package',
  type : 'boolean',
  value : false,
  description : 'Install only the redistributable OPK release surface'
)

option('deb_package',
  type : 'boolean',
  value : false,
  description : 'Enable the Meson opk-runtime Debian package target'
)

option('demo_deb_package',
  type : 'boolean',
  value : false,
  description : 'Enable the Meson opk-demo Debian package target'
)

option('deb_package_revision',
  type : 'string',
  value : '1',
  description : 'Debian revision appended to the OPK product version'
)

option('open_perception_kit_dir',
  type : 'string',
  value : '',
  description : 'Directory containing a verified Open Perception Kit ZIP, checksum, and provenance triplet'
)

option('executorch',
  type : 'feature',
  value : 'auto',
  description : 'Enable ExecuTorch integration'
)

option('python_ops',
  type : 'feature',
  value : 'auto',
  description : 'Enable the embedded Python script Op'
)
