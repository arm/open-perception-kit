precision highp float;
precision highp int;
layout(local_size_x = WORKGROUP_WIDTH, local_size_y = WORKGROUP_HEIGHT) in;
layout(binding = 0) uniform highp sampler2D plane0;
layout(binding = 1) uniform highp sampler2D plane1;
layout(binding = 2) uniform highp sampler2D plane2;
layout(std430, binding = 0) buffer Tensor {
    float values[];
};
uniform ivec2 outputSize;
uniform ivec4 crop;
uniform ivec4 inner;
uniform int sourceFormat;
uniform bool channelsFirst;
uniform bool swapRedBlue;
uniform vec3 mean;
uniform vec3 inverseStd;
uniform vec3 padding;
uniform vec4 yuvRange;
uniform vec4 yuvCoefficients;
const float byteMaximum = 255.0;
const int rgbChannels = 3;
const int chromaSubsampling = 2;
const int rgbFormat = 0;
const int nv12Format = 1;
const int yuy2Format = 3;

vec3 readRgb(ivec2 pixel) {
    if (sourceFormat == rgbFormat) {
        vec3 rgb = texelFetch(plane0, pixel, 0).rgb;
        return round((swapRedBlue ? rgb.bgr : rgb) * byteMaximum) / byteMaximum;
    }
    float y;
    vec2 uv;
    if (sourceFormat == yuy2Format) {
        y = texelFetch(plane0, pixel, 0).r;
        ivec2 pair = ivec2((pixel.x / chromaSubsampling) * chromaSubsampling, pixel.y);
        uv = vec2(texelFetch(plane0, pair, 0).g, texelFetch(plane0, pair + ivec2(1, 0), 0).g);
    } else {
        y = texelFetch(plane0, pixel, 0).r;
        if (sourceFormat == nv12Format) {
            uv = texelFetch(plane1, pixel / chromaSubsampling, 0).rg;
        } else {
            uv = vec2(texelFetch(plane1, pixel / chromaSubsampling, 0).r,
                      texelFetch(plane2, pixel / chromaSubsampling, 0).r);
        }
    }
    // Recover integer samples before conversion; normalized texture precision is driver-dependent.
    y = (round(y * byteMaximum) - yuvRange.x) * yuvRange.y;
    uv = (round(uv * byteMaximum) - yuvRange.z) * yuvRange.w;
    return clamp(vec3(y + yuvCoefficients.x * uv.y,
                      y - yuvCoefficients.z * uv.x - yuvCoefficients.w * uv.y,
                      y + yuvCoefficients.y * uv.x),
                 0.0,
                 1.0);
}
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, outputSize)))
        return;
    vec3 rgb = padding;
    ivec2 relative = p - inner.xy;
    if (all(greaterThanEqual(relative, ivec2(0))) && all(lessThan(relative, inner.zw))) {
        ivec2 source = crop.xy + (relative * crop.zw) / inner.zw;
        rgb = readRgb(source);
    }
    rgb = (rgb - mean) * inverseStd;
    int index = p.y * outputSize.x + p.x;
    int planeSize = outputSize.x * outputSize.y;
    for (int channel = 0; channel < rgbChannels; channel++) {
        values[channelsFirst ? channel * planeSize + index : index * rgbChannels + channel] =
            rgb[channel];
    }
}
