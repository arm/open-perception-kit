@startuml
title Current Container Structure: Dockerfile Targets and Helper Dockerfiles

skinparam backgroundColor #ffffff
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam ArrowColor #4b5563
skinparam componentStyle rectangle
skinparam packageStyle rectangle

skinparam component {
  BorderColor #374151
  BackgroundColor #f9fafb
  FontColor #111827
}

skinparam database {
  BorderColor #1f2937
  BackgroundColor #e5e7eb
}

skinparam note {
  BorderColor #9ca3af
  BackgroundColor #fff7ed
}

left to right direction

legend right
  |= Color |= Meaning |
  |<#bbf7d0> | Final usable image target |
  |<#bfdbfe> | Reusable stage inherited by other targets |
  |<#fed7aa> | Build or artifact stage that produces selected outputs |
  |<#e5e7eb> | External base image |
endlegend

package "External Base Images" {
  database "debian:trixie-slim" as debian
  database "python:3.13-slim-trixie" as py313
}

package "Dockerfile\ncore cross-lane stage graph" {
  package "Shared Artifact Stages\n(selected outputs copied into other lanes)" {
    component "opk-models\nHugging Face model artifact stage" as models #fed7aa
    component "opk-demo-media\ndemo video artifact stage" as demo_media #fed7aa

    py313 --> models : FROM
    debian --> demo_media : FROM
  }

  package "Development Tooling Images\n(no OPK binaries built into opk-dev)" {
    component "opk-build-base\nshared native build tools" as build_base #bfdbfe
    component "opk-dev-base\nshared build/runtime + checkout entrypoint" as dev_base #bfdbfe
    component "opk-dev-tools\nshell, editor, debugger, network tools" as dev_tools #bfdbfe
    component "opk-dev\ndevcontainer target\nrepo at OPK_PROJECT_ROOT" as dev_image #bbf7d0
    component "opk-dev-macos-cache-build\nnative Arm64 ccache seed" as dev_cache #fed7aa
    component "opk-dev-macos-ci\nArm64 development image + ccache seed" as dev_ci #bbf7d0

    py313 --> build_base : FROM
    build_base --> dev_base : FROM
    dev_base --> dev_tools : FROM
    dev_tools --> dev_image : FROM
    dev_image --> dev_cache : FROM + build checkout
    dev_image --> dev_ci : FROM
    dev_cache ..> dev_ci : COPY ccache seed
    models ..> dev_image : COPY model artifacts\n/opt/opk-app/config/models
    demo_media ..> dev_image : COPY demo videos\n/opt/opk-app/data/videos
  }

  package "Documentation Image Lane" {
    component "opk-docs\ndocs-focused target" as docs_image #bbf7d0

    dev_base --> docs_image : FROM
  }

  package "Deployment Build and Runtime Images" {
    component "opk-cross-build-base\ncross-build root" as cross_base #bfdbfe
    component "opk-deployment-build\nrelease toolchain and builder\ncollects app + SDK + tarball" as deployment_build #fed7aa
    component "opk-deployment-base\nrunnable deployment image\nprebuilt OPK + tarball" as deployment_image #bbf7d0

    build_base --> cross_base : FROM
    cross_base --> deployment_build : FROM
    demo_media ..> deployment_build : COPY demo videos
    py313 --> deployment_image : FROM
    deployment_build ..> deployment_image : COPY selected outputs\n/opt/opk-app, release tarball, ONNX Runtime libs
  }
}

package "Helper Dockerfiles\nindependent workflow runtimes" {
  component "Dockerfile.pre-commit\nopk-pre-commit-runtime" as pre_commit #bbf7d0

  py313 --> pre_commit : FROM
}

note right of dev_image
  Contract: tools and dependency libraries plus
  optional downloaded model and demo media artifacts. The
  repository is mounted at OPK_PROJECT_ROOT; OPK binaries are
  built from that checkout, not copied into this image.
end note

note right of dev_ci
  Local macOS quick-start selects this target
  through its Compose override.
end note

note bottom of deployment_build
  Deployment is the only core lane that builds OPK
  during image creation. It copies model configurations
  from the checkout and uses the demo media artifact stage.
  Native release builds also package
  the checked-in open-perception-kit snapshot and create the
  validated architecture tarball. The runtime target
  copies selected outputs, not compilers or build scratch state.
end note

note bottom of pre_commit
  Helper Dockerfiles are separate because they do not
  inherit from the shared Debian build graph.
end note

@enduml
