@startuml
title Current Container Structure: Dockerfile Targets and Helper Dockerfiles

skinparam backgroundColor #ffffff
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam ArrowColor #4b5563
skinparam componentStyle rectangle
skinparam packageStyle rectangle

skinparam component {
  BorderColor #374151
  BackgroundColor #f9fafb
  FontColor #111827
}

skinparam database {
  BorderColor #1f2937
  BackgroundColor #e5e7eb
}

skinparam note {
  BorderColor #9ca3af
  BackgroundColor #fff7ed
}

left to right direction

legend right
  |= Color |= Meaning |
  |<#bbf7d0> | Final usable image target |
  |<#bfdbfe> | Reusable stage inherited by other targets |
  |<#fed7aa> | Build stage that produces selected artifacts |
  |<#fef3c7> | CI service/job using a built image |
  |<#e5e7eb> | External base image |
endlegend

package "External Base Images" {
  database "debian:trixie-slim" as debian
  database "python:3.12-slim-trixie" as py312
  database "python:3.13-slim-trixie" as py313
}

package "Dockerfile\ncore cross-lane stage graph" {
  package "Development Tooling Images\n(no PEK binaries built into pek-dev)" {
    component "pek-build-base\nshared native build tools" as build_base #bfdbfe
    component "pek-dev-base\ninteractive build/runtime base" as dev_base #bfdbfe
    component "pek-dev-tools\nshell, editor, debugger, network tools" as dev_tools #bfdbfe
    component "pek-dev\ndevcontainer target\nrepo mounted at /work" as dev_image #bbf7d0

    debian --> build_base : FROM
    build_base --> dev_base : FROM
    dev_base --> dev_tools : FROM
    dev_tools --> dev_image : FROM
  }

  package "Documentation Image Lane" {
    component "pek-docs\ndocs-focused target" as docs_image #bbf7d0

    dev_base --> docs_image : FROM
  }

  package "CI Image Lane" {
    component "pek-ci\nbroad verification target" as ci_image #bbf7d0

    dev_base --> ci_image : FROM
  }

  package "Deployment Build and Runtime Images" {
    component "pek-deployment-build\nrelease builder stage\ncollects /opt/pek-app" as deployment_build #fed7aa
    component "pek-deployment-base\nslim runtime target\nprebuilt PEK release" as deployment_image #bbf7d0

    build_base --> deployment_build : FROM
    debian --> deployment_image : FROM
    deployment_build ..> deployment_image : COPY selected outputs\n/opt/pek-app, ONNX Runtime libs
  }
}

package "Helper Dockerfiles\nindependent workflow runtimes" {
  component "Dockerfile.pre-commit\npek-pre-commit-runtime" as pre_commit #bbf7d0
  component "Dockerfile.pages\npek-playwright-pages" as pages #bbf7d0

  py312 --> pre_commit : FROM
  py313 --> pages : FROM
}

package "CI Service Mapping" {
  component "CI: pek-build-base" as ci_build_base #fef3c7
  component "CI: pek-deployment-base" as ci_deploy #fef3c7
  component "CI: pek-release-with-ut" as ci_release #fef3c7
  component "CI: pek-valgrind-check" as ci_valgrind #fef3c7
  component "CI: pek-generate-valgrind-summary" as ci_valgrind_summary #fef3c7
  component "CI: pek-quality-check-full" as ci_quality_full #fef3c7
  component "CI: pek-sonar-check" as ci_sonar #fef3c7
  component "CI: pek-sonar-check-release" as ci_sonar_release #fef3c7
  component "CI: pek-quality-check-pull-request" as ci_quality_pr #fef3c7
  component "CI: pek-clang-tidy-baseline-check" as ci_clang_tidy #fef3c7
  component "CI: pek-pre-commit-runtime" as ci_pre_commit #fef3c7
  component "CI: pek-playwright-pages" as ci_pages #fef3c7

  build_base ..> ci_build_base : image target
  deployment_image ..> ci_deploy : image target
  ci_image ..> ci_release : runs build/tests\nfrom checkout
  ci_image ..> ci_valgrind : runs valgrind tests\nfrom checkout
  ci_image ..> ci_valgrind_summary : parses valgrind logs
  ci_image ..> ci_quality_full : quality checks + docs
  ci_image ..> ci_sonar : coverage + sonar scan
  ci_image ..> ci_sonar_release : coverage + release scan
  ci_image ..> ci_quality_pr : PR checks
  ci_image ..> ci_clang_tidy : clang-tidy baseline
  pre_commit ..> ci_pre_commit : repo checks
  pages ..> ci_pages : report page publishing
}

note right of dev_image
  Contract: tools and dependency libraries only.
  The repository is mounted at /work; PEK binaries
  are built from that checkout, not copied into this image.
end note

note bottom of deployment_build
  Deployment is the only core lane that builds PEK
  during image creation. The runtime target copies
  selected outputs, not compilers or build scratch state.
end note

note bottom of pre_commit
  Helper Dockerfiles are separate because they do not
  inherit from the shared Debian build graph.
end note

@enduml
