@startuml
' Architecture sketch for element-owned FlatBuffer payloads carried inside a
' shared metadata container and published for user-side parsing.
!include _plantuml/colors.puml

left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam defaultTextAlignment center
skinparam wrapWidth 200
' skinparam linetype polyline

package "Built-in Schema Contract" as schema_contract $CONTAINER_COLOR {
  artifact "PerceptionContainer.fbs" as container_schema $SCHEMA_COLOR
  artifact "InferPayload.fbs" as infer_schema $SCHEMA_COLOR
  artifact "TrackerPayload.fbs" as tracker_schema $SCHEMA_COLOR
  artifact "PerfPayload.fbs" as perf_schema $SCHEMA_COLOR
}

package "User-defined Schema Contract" as user_schema_contract $CONTAINER_COLOR {
  artifact "InferPayload.fbs" as user_infer_schema $SCHEMA_COLOR
  artifact "PostProcessingContainer.fbs" as user_post_processing_container_schema $SCHEMA_COLOR
}

package "Perception Service" as runtime $CONTAINER_COLOR {
  package "Manager Application" as manager_app $EXECUTABLE_COLOR {
    artifact "Built-in C++ bindings" as user_bindings_cpp $EXECUTABLE_COLOR
    component "Metadata container" as meta_container $STORE_COLOR
    component "redis pub/sub" as redis_api $INTERNAL_MODULE_COLOR

    package "Pipeline elements" as pipeline $PIPELINE_COLOR {
      component "opk-elements" as pekelement
      component "opk-infer" as pekinfer
      package "opk-post-processing" as pekpostprocessing {
        component "built-in-post-processing" as pekbuiltinpostprocessing
        component "user-def-post-processing" as pekuserpostprocessing
      }
    }
  }
}
pekelement --> pekinfer
pekinfer --> pekpostprocessing

package "User Container" as user_side $CONTAINER_COLOR {
  package "App" as app $EXECUTABLE_COLOR {
    artifact "Built-in Python bindings" as builtin_bindings_py $EXECUTABLE_COLOR
    artifact "User Python bindings" as user_bindings_py $EXECUTABLE_COLOR
    rectangle "Container parser" as container_parser
    ' rectangle "Element payload parsers\n(parse FlatBuffer payload blobs)" as payload_parsers
  }
}
database "Redis" as redis $STORE_COLOR

schema_contract ..[$CONTRACT_COLOR,dashed]-> builtin_bindings_py
schema_contract ..[$CONTRACT_COLOR,dashed]-> user_bindings_cpp 

user_bindings_cpp ..[$CONTRACT_COLOR,dashed]-> pekbuiltinpostprocessing
user_schema_contract ..[$CONTRACT_COLOR,dashed]-> user_bindings_py
user_bindings_py ..[$CONTRACT_COLOR,dashed]-> pekuserpostprocessing


meta_container <-[$METADATA_COLOR,thickness=2]-> pipeline
meta_container <-[$METADATA_COLOR,thickness=2]-> redis_api

redis_api -[$METADATA_COLOR,thickness=2]-> redis : publish flattened blob
redis -[$METADATA_COLOR,thickness=2]-> container_parser : delivered container payload

note right of pipeline
Each processing element:
- reads the current metadata container
- parses payloads it understands
- appends or replaces its own FlatBuffer payload as a flattened blob
end note

note right of user_side
User-side parsing depends on the same FlatBuffer schemas being
published as part of the external contract, not only kept inside
the runtime implementation.
end note

@enduml
