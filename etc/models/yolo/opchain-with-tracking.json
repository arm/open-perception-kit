{
    "name": "YoloV11WithTracking",
    "ops": [
        {
            "id": "amp-std-ops/InferenceController",
            "attributes": {}
        },
        {
            "id": "amp-std-ops/GenericImagePreprocess",
            "attributes": {
                "inputImageTensorIndex": 0,
                "inputImageSourceName": "pipelineVideoFrame"
            }
        },
        {
            "id": "amp-onnx-ops/Inference",
            "attributes": {
                "modelDescriptor": "/work/etc/models/yolo/yolo.json"
            }
        },
        {
            "id": "amp-std-ops/GenericPostprocess",
            "attributes": {
                "parser": "YoloParser",
                "normalizeOutputCoordinates": false,
                "applyNms": true,
                "confidenceThreshold": 0.25,
                "iouThreshold": 0.45
            }
        },
        {
            "id": "amp-std-ops/Tracker",
            "attributes": {
                "contentType": "genericObject",
                "iouThreshold": 0.3,
                "maxMissedFrames": 5,
                "minHitsToConfirm": 3,
                "appendTrackIdToText": true
            }
        }
    ]
}