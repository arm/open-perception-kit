{
	"name": "yolo-onnx",
	"modelFamily": "yolo-obj",
	"modelFile": "yolo11n-fp32-320.onnx",
	"dynamicOutput": true,
	"maxDetectionCount": 16,
	"confidenceThreshold": 0.7,
	"iouThreshold": 0.5,
	"inputTensors": [
		{
			"shape": [
				1,
				3,
				320,
				320
			],
			"dataKind": "ImageRgbChw"
		}
	],
	"tensorFeedbacks": [
	  { "fromOutputTensorIndex": 0, "toInputTensorIndex": 0,  "mode": "Copy" },
	  { "fromOutputTensorIndex": 1, "toInputTensorIndex": 1, "mode": "Copy" }
	]
}

