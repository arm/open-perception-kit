+MatMulTile GetMaliMatMulTile(const wgpu::AdapterInfo& adapter_info,
+                             const bool eligible, const uint32_t output_rows) {
+  constexpr uint32_t GenericWorkgroupRows = 8;
+  constexpr uint32_t SmallMatrixRows = 8;
+  constexpr int64_t GenericOutputRows = 4;
+  constexpr int64_t SmallOutputRows = 1;
+  const MatMulTile generic{GenericWorkgroupRows,
+                           output_rows <= SmallMatrixRows ? SmallOutputRows : GenericOutputRows};
+  if (!eligible || adapter_info.vendor != std::string_view{"arm"}) {
+    return generic;
+  }
+
+  // Keep the sweep opt-in until complete-model measurements select a Mali tile.
+  static const auto selected = []() -> std::optional<MatMulTile> {
+    const char* const setting = std::getenv("ORT_WEBGPU_MALI_TILE");
+    if (setting == nullptr) {
+      return std::nullopt;
+    }
+    struct Candidate {
+      std::string_view name;
+      MatMulTile tile;
+    };
+    const std::array candidates{
+        Candidate{"8x8-r1", {8, 1}}, Candidate{"8x8-r2", {8, 2}},
+        Candidate{"8x16-r1", {16, 1}}, Candidate{"8x16-r2", {16, 2}},
+        Candidate{"8x4-r2", {4, 2}}, Candidate{"8x32-r1", {32, 1}}};
+    for (const auto& candidate : candidates) {
+      if (candidate.name == setting) {
+        LOGS_DEFAULT(INFO) << "Selected Mali FP32 tile " << candidate.name;
+        return candidate.tile;
+      }
+    }
+    ORT_THROW("Unknown ORT_WEBGPU_MALI_TILE: ", setting);
+  }();
+  if (!selected.has_value()) {
+    return generic;
+  }
+  return {selected->workgroup_rows,
+          output_rows <= SmallMatrixRows ? SmallOutputRows : selected->output_rows_per_thread};
+}
