{
  "dependencies": {
    "flatbuffers": "25.9.23"
  },
  "description": "Generated perception TypeScript SDK",
  "devDependencies": {
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "import": "./dist/perception/index.js",
      "types": "./dist/perception/index.d.ts"
    },
    "./fb/*.js": {
      "import": "./dist/perception/fb/*.js",
      "types": "./dist/perception/fb/*.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE"
  ],
  "license": "Apache-2.0",
  "main": "./dist/perception/index.js",
  "name": "perception",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "type": "module",
  "types": "./dist/perception/index.d.ts",
  "version": "0.1.0"
}
