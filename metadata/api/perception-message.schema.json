{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amp-dev-forge.local/metadata/api/perception-message.schema.json",
  "title": "AMP Perception Transport Message",
  "description": "Schema for the JSON transport message emitted today by development/elements/pekcomm/writer.cpp.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "frame_counter",
    "perception"
  ],
  "properties": {
    "frame_counter": {
      "type": "integer",
      "minimum": 0
    },
    "perception": {
      "oneOf": [
        {
          "$ref": "./perception.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
