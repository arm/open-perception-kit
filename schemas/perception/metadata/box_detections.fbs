include "common.fbs";

namespace open_perception_kit.metadata;

table BoxDetection {
  object:open_perception_kit.metadata.ObjectMeta;
  box:open_perception_kit.metadata.BoundingBox;
  confidence:float;
  class_id:int = -1;
  text:string;
}

table BoxDetections {
  schema_major:ushort = 1;
  schema_minor:ushort = 0;
  layer:open_perception_kit.metadata.LayerInfo;
  detections:[open_perception_kit.metadata.BoxDetection];
}

root_type BoxDetections;
file_identifier "BDET";
