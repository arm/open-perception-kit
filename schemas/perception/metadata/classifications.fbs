include "common.fbs";

namespace open_perception_kit.metadata;

enum ClassificationKind:ubyte { Unspecified, Categorical, RecognizedText }

table ClassificationCandidate {
  // Optional finite score in [0,1]. Zero is valid; absence means no score supplied.
  confidence:float = null;
  // Optional non-negative identity within Classification.label_set. Zero is valid.
  class_id:uint = null;
  // Display label for Categorical, literal content for RecognizedText.
  text:string;
}

table Classification {
  object:open_perception_kit.metadata.ObjectMeta;
  // Producer-defined order, highest-ranked candidate first. Empty means no candidates.
  candidates:[open_perception_kit.metadata.ClassificationCandidate];
  // Required for Categorical identity; empty for RecognizedText.
  label_set:string;
  // Kind is declared, never inferred from absent identity fields or display text.
  kind:ClassificationKind = Unspecified;
  // Input observation, independent of derivation. Image consumers resolve a
  // unique VideoFrameContext, BoxDetection or ObjectTrack in this packet.
  subject_id:ulong = null;
}

table Classifications {
  schema_major:ushort = 1;
  schema_minor:ushort = 0;
  layer:open_perception_kit.metadata.LayerInfo;
  classifications:[open_perception_kit.metadata.Classification];
}

root_type Classifications;
file_identifier "CLSF";
