include "common.fbs";

namespace open_perception_kit.metadata;

table VideoFrameContext {
  object:open_perception_kit.metadata.ObjectMeta;
  original_width:ulong;
  original_height:ulong;
  // Media presentation time; absent when the backend has no PTS. Zero is valid.
  presentation_ts_ns:ulong = null;
}

table AudioFrameContext {
  object:open_perception_kit.metadata.ObjectMeta;
  original_channels:ulong;
  original_frequency:ulong;
  original_sample_count:ulong;
  cut_left_sample_count:ulong;
  cut_right_sample_count:ulong;
  // Original input buffer PTS; not the normalized inference-window clock.
  presentation_ts_ns:ulong = null;
}

table FrameContext {
  schema_major:ushort = 1;
  schema_minor:ushort = 0;
  layer:open_perception_kit.metadata.LayerInfo;
  video:open_perception_kit.metadata.VideoFrameContext;
  audio:open_perception_kit.metadata.AudioFrameContext;
}

root_type FrameContext;
file_identifier "FCTX";
