include "common.fbs";

namespace open_perception_kit.metadata;

table InstanceSegmentationMask {
  object:open_perception_kit.metadata.ObjectMeta;
  // Uint8 binary membership: 0 outside, 1 inside this observation. Other values
  // are invalid. Different instances may overlap; IDs are not stored in pixels.
  bitmap:open_perception_kit.metadata.BitmapData;
  class_id:uint = null;
  confidence:float = null;
  // Optional detection geometry, not the bitmap's placement transform.
  box:open_perception_kit.metadata.BoundingBox;
  // Required to interpret a present class_id; independent of display label_family.
  label_set:string;
}

table InstanceSegmentationMasks {
  schema_major:ushort = 1;
  schema_minor:ushort = 0;
  layer:open_perception_kit.metadata.LayerInfo;
  masks:[open_perception_kit.metadata.InstanceSegmentationMask];
}

root_type InstanceSegmentationMasks;
file_identifier "ISGM";
