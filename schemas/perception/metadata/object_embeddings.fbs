include "common.fbs";

namespace open_perception_kit.metadata;

table ObjectEmbedding {
  object:open_perception_kit.metadata.ObjectMeta;
  values:[float];
}

table ObjectEmbeddings {
  schema_major:ushort = 1;
  schema_minor:ushort = 0;
  layer:open_perception_kit.metadata.LayerInfo;
  embeddings:[open_perception_kit.metadata.ObjectEmbedding];
}

root_type ObjectEmbeddings;
file_identifier "EMBE";
