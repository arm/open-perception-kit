include "tracking.fbs";

namespace open_perception_kit.metadata;

table ObjectTrack {
  object:open_perception_kit.metadata.ObjectMeta;
  // Original observation ID; predicted samples may refer to an earlier packet.
  source_id:ulong = null;
  identity:TrackIdentity;
  box:open_perception_kit.metadata.BoundingBox;
  // Confidence of the source detection, not a prediction quality estimate.
  source_confidence:float = null;
  // Preserve the detection's optional category identity, including valid zero.
  class_id:uint = null;
  // Original display label, without tracker IDs or diagnostics appended.
  text:string;
  association:TrackAssociation;
  sample:TrackingSample;
  // Observed: equal to sample.frame_index; predicted: strictly earlier.
  // Absent together with source_id when the source is unknown.
  source_frame_index:ulong = null;
}

table ObjectTracks {
  schema_major:ushort = 1;
  schema_minor:ushort = 0;
  layer:open_perception_kit.metadata.LayerInfo;
  tracks:[open_perception_kit.metadata.ObjectTrack];
  // Presentation preference only; renderers construct the familiar ID/diagnostic label.
  display_identity:bool = true;
}

root_type ObjectTracks;
file_identifier "TRKS";
