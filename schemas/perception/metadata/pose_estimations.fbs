include "common.fbs";

namespace open_perception_kit.metadata;

table PoseEstimation {
  object:open_perception_kit.metadata.ObjectMeta;
  confidence:float;
  yaw:float;
  pitch:float;
}

table PoseEstimations {
  schema_major:ushort = 1;
  schema_minor:ushort = 0;
  layer:open_perception_kit.metadata.LayerInfo;
  poses:[open_perception_kit.metadata.PoseEstimation];
}

root_type PoseEstimations;
file_identifier "POSE";
