include "common.fbs";

namespace open_perception_kit.metadata;

table TrackTrace {
  object:open_perception_kit.metadata.ObjectMeta;
  track_id:ulong;
  points:[open_perception_kit.metadata.Point2f];
  // Trace points are pixels in this image basis, independent of object.parent_id.
  space:open_perception_kit.metadata.ImageSpace;
}

table TrackTraces {
  schema_major:ushort = 1;
  schema_minor:ushort = 0;
  layer:open_perception_kit.metadata.LayerInfo;
  traces:[open_perception_kit.metadata.TrackTrace];
}

root_type TrackTraces;
file_identifier "TRCE";
