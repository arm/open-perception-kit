{
  "description": "Test the onnx tracking plugin with a simple pipeline that decodes a JPEG image, runs inference on the yolo and tracking, and sends the output to a fakesink.",
  "pipeline": [
    "filesrc location=/work/etc/images/katana.jpg !",
    "jpegdec !",
    "imagefreeze num-buffers=${NUM_FRAMES:-30} !",
    "videoconvert ! video/x-raw,format=BGRA,framerate=30/1 !",
    "ampinfer opchain-path=/work/etc/models/yolo/opchain.json active=true !",
    "ampinfer opchain-path=/work/etc/models/osnet_x0_25/opchain.json active=true !",
    "amptracker content-type=genericObject !",
    "fakesink sync=true"
  ]
}