  *******************************************************************************/

 #include "compute_graph_op.hpp"
+#include "conv2d_dispatch_limits.h"
 #include "graph_log.hpp"

 #include <algorithm>
@@ -855,7 +856,17 @@
           createSpirv(_pipelineCache, _input->getFormat(), _output->getFormat(), _weights->getFormat(), _accType),
           debugName),
       pushConstant{createPushConstant(_pad, _stride, _dilation, _inputZeroPoint, _weightZeroPoint)},
-      maxGroupCount{_maxGroupCount} {}
+      maxGroupCount{opk::rpi5::conv2dDispatchLimits(
+          { // Spend the unchanged work budget only on groups in this output grid.
+              std::min(_maxGroupCount[0], std::max(1U, divideRoundUp(static_cast<uint32_t>(
+                  _output->getDimensions()[0] * _output->getDimensions()[2]), warpX))),
+              std::min(_maxGroupCount[1], std::max(1U, divideRoundUp(
+                  static_cast<uint32_t>(_output->getDimensions()[1]), warpY))),
+              std::min(_maxGroupCount[2], std::max(1U, divideRoundUp(
+                  static_cast<uint32_t>(_output->getDimensions()[3]), warpZ * 4))),
+          },
+          _weights->getDimensions()[1], _weights->getDimensions()[2],
+          _input->getDimensions()[3])} {}

