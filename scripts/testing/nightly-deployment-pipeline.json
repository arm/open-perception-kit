{
  "version": "1.0.1",
  "description": "Finite nightly face and camera-contact cascade.",
  "loop": false,
  "pipeline": [
    "filesrc location=\"${image}\" !",
    "jpegdec ! imagefreeze num-buffers=1 !",
    "videoconvert ! video/x-raw,format=BGRA !",
    "opkinfer opchain-path=\"${opk_data}/opchains/nitec-resnet-18/opchain-executorch.json\" active=true !",
    "opkcomm method=file file-name=\"${results}\" !",
    "fakesink sync=false"
  ]
}
