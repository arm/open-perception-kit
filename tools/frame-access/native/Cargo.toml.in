[package]
name = "frame-access-integration-test"
version = "0.0.0"
edition = "2021"
publish = false

[dependencies]
iceoryx2 = { version = "=0.10.0", path = "@ICEORYX2_SOURCE_DIR@/iceoryx2" }
flatbuffers = "=25.12.19"
open_perception_kit = { path = "@OPK_ROOT@/generated/open_perception_kit/rust" }

[[bin]]
name = "frame_access_client"
path = "@CMAKE_CURRENT_SOURCE_DIR@/native/client.rs"
