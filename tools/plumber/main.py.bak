#!/usr/bin/env python3
import json
import time
from pathlib import Path
import base64
import zlib
import numpy as np
import jmespath
from PIL import Image

FIFO_PATH = "/tmp/ampcomm"

def save_mask_as_bmp(mask: np.ndarray, filename: str):
    """
    mask: 2D numpy array (H, W), dtype uint8
    """
    if mask.dtype != np.uint8:
        mask = mask.astype(np.uint8)

    img = Image.fromarray(mask, mode="L")  # "L" = 8-bit grayscale
    img.save(filename, format="BMP")


def decode_bitmap_from_detection(detection: dict) -> np.ndarray:
    """
    Extracts and decodes bitmap from one detection entry.
    Returns a NumPy array shaped (height, width).
    """

    bitmap = detection["data"]["bitmap"]

    data_b64 = bitmap["data_b64"]
    encoding = bitmap.get("encoding", "")
    width = bitmap["width"]
    height = bitmap["height"]
    dtype_str = bitmap["type"]

    # --- Step 1: Base64 decode ---
    raw_bytes = base64.b64decode(data_b64)

    # --- Step 2: Optional zlib decompress ---
    if "zlib" in encoding:
        try:
            raw_bytes = zlib.decompress(raw_bytes)
        except zlib.error:
            # Fallback: data was not compressed
            pass

    # --- Step 3: Map type string to numpy dtype ---
    dtype_map = {
        "Uint8": np.uint8,
        "Int8": np.int8,
        "Uint16": np.uint16,
        "Int16": np.int16,
        "Uint32": np.uint32,
        "Int32": np.int32,
        "Float32": np.float32,
        "Float64": np.float64,
    }

    if dtype_str not in dtype_map:
        raise ValueError(f"Unsupported bitmap type: {dtype_str}")

    dtype = dtype_map[dtype_str]

    # --- Step 4: Convert to NumPy array ---
    array = np.frombuffer(raw_bytes, dtype=dtype)

    # Safety check
    expected_size = width * height
    if array.size != expected_size:
        raise ValueError(
            f"Decoded size mismatch: got {array.size}, expected {expected_size}"
        )

    return array.reshape((height, width))


expr = """
    perception.layers[?contentType=='segmentation'].detections[] || []
    """
expr_compile = jmespath.compile(expr)
def handle_message(obj: dict) -> None:
    fc = obj["frame_counter"]

    result = expr_compile.search(obj)
    mask = decode_bitmap_from_detection(result[0])

    save_mask_as_bmp(mask, "mask_" + str(fc) + ".bmp")


def read_fifo_lines(path: str) -> None:
    fifo = Path(path)

    # Ensure it exists and is a FIFO
    if not fifo.exists():
        raise FileNotFoundError(f"FIFO does not exist: {path}")
    if not fifo.is_fifo():
        raise ValueError(f"Path exists but is not a FIFO: {path}")

    while True:
        # Opening a FIFO for reading will block until a writer opens it.
        # When the writer closes, the iterator ends (EOF) and we reopen.
        try:
            with fifo.open("r", encoding="utf-8", newline="") as f:
                for line in f:
                    line = line.strip()
                    if not line:
                        continue

                    try:
                        msg = json.loads(line)
                    except json.JSONDecodeError as e:
                        # Keep going if one line is bad
                        print(f"Bad JSON line (skipping): {e}; line={line!r}")
                        continue

                    handle_message(msg)

        except Exception as e:
            # If something unexpected happens, don't spin at 100% CPU
            print(f"Error reading FIFO: {e!r} (retrying soon)")
            time.sleep(0.5)

if __name__ == "__main__":
    read_fifo_lines(FIFO_PATH)
